. * Audit 2026-09-07c -- referee variants on the collapsed-panel triple-diff (r
> eghdfe).
. * Input : New/Data/Collapsed/collapsed_omnibus.dta (author's export, read-onl
> y)
. * Output: New/replication/audit_2026-09-07c/collapsed_eif_variants_stata.csv
. * Baseline must reproduce omnibus_collapsed_reghdfe.csv: WB green -0.0045685,
>  WB dirty -0.0118734
. clear all

. set more off

. set varabbrev off

. global ROOT "C:/Work/projects/Paper_PTA"

. global OUTD "$ROOT/New/replication/audit_2026-09-07c"

. cap log close _all

. log using "$OUTD/replicate_collapsed_eif_variants_stata.log", replace text
-------------------------------------------------------------------------------
      name:  <unnamed>
       log:  C:/Work/projects/Paper_PTA/New/replication/audit_2026-09-07c/repli
> cate_collapsed_eif_variants_stata.log
  log type:  text
 opened on:   8 Sep 2026, 10:52:24

. global CSV "$OUTD/collapsed_eif_variants_stata.csv"

. file open fh using "$CSV", write replace text

. file write fh "variant,depth,index,cluster,coef_green,se_green,p_green,coef_d
> irty,se_dirty,p_dirty,nobs,nclust" _n

. file close fh

. 
. use hs6 country_code year y n WB_EP_Depth TREND_EP_Count env_good dirty_p Tot
> alDepth_nonEnv DESTA_depth_index pd dt pt ///
>     using "$ROOT/New/Data/Collapsed/collapsed_omnibus.dta", clear

. su WB_EP_Depth, meanonly

. assert r(max) == 17

. count
  3,773,498

. di "cells: " r(N)
cells: 3773498

. * profile clusters: ASEAN-only block and Bangkok-only block
. gen long profile = country_code

. replace profile = 9001 if inlist(country_code, 105,106,107,112,122,129,136,14
> 1,144)
(304,748 real changes made)

. replace profile = 9002 if inlist(country_code, 103,111,134)
(112,425 real changes made)

. tempfile base

. save `base'
file C:\Users\edodr\AppData\Local\Temp\ST_105c_000001.tmp saved as .dta
    format

. 
. capture program drop est_one

. program define est_one
  1.     args variant depth clus
  2.     * depth: td | desta
.     if "`depth'" == "desta" {
  3.         drop if missing(DESTA_depth_index) & WB_EP_Depth > 0
  4.         gen double TD = cond(missing(DESTA_depth_index), 0, DESTA_depth_in
> dex)
  5.     }
  6.     else gen double TD = TotalDepth_nonEnv
  7.     foreach ix in WB TREND {
  8.         local ep = cond("`ix'"=="WB", "WB_EP_Depth", "TREND_EP_Count")
  9.         gen double ep_g = `ep' * env_good
 10.         gen double ep_d = `ep' * dirty_p
 11.         gen double td_g = TD * env_good
 12.         gen double td_d = TD * dirty_p
 13.         reghdfe y ep_g ep_d td_g td_d [aw=n], absorb(pd dt pt) vce(cluster
>  `clus')
 14.         local nc = e(N_clust)
 15.         local pg = 2*ttail(`nc'-1, abs(_b[ep_g]/_se[ep_g]))
 16.         local pd = 2*ttail(`nc'-1, abs(_b[ep_d]/_se[ep_d]))
 17.         file open fh using "$CSV", write append text
 18.         file write fh "`variant',`depth',`ix',`clus'," (_b[ep_g]) "," (_se
> [ep_g]) "," (`pg') "," (_b[ep_d]) "," (_se[ep_d]) "," (`pd') "," (e(N)) "," (
> `nc') _n
 19.         file close fh
 20.         drop ep_g ep_d td_g td_d
 21.     }
 22.     drop TD
 23. end

. 
. * recode helper: set (cc, y0) treatment vars to their (cc, y0-1) values
. capture program drop recode_prev

. program define recode_prev
  1.     args cc y0
  2.     foreach v in WB_EP_Depth TREND_EP_Count TotalDepth_nonEnv DESTA_depth_
> index {
  3.         qui su `v' if country_code == `cc' & year == `y0'-1, meanonly
  4.         local m = cond(r(N) > 0, r(mean), 0)
  5.         qui replace `v' = `m' if country_code == `cc' & year == `y0'
  6.     }
  7. end

