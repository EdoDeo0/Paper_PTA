 opened on:   6 Sep 2026, 02:31:08

. 
. cap which reghdfe

. if _rc ssc install reghdfe

. 
. *── Liste ausiliarie ────────────────────────────────────────────────────────
> ──
. import delimited "$ROOT/New/Data/Classifications/green_codes_hs1996.csv", cle
> ar
(encoding automatically selected: ISO-8859-2)
(7 vars, 248 obs)

. keep hs6_final

. rename hs6_final hs6

. duplicates drop hs6, force

Duplicates in terms of hs6

(2 observations deleted)

. gen byte env_good = 1

. tempfile green

. save `green'
file C:\Users\edodr\AppData\Local\Temp\ST_21c_000001.tmp saved as .dta format

. 
. import delimited "$ROOT/New/Data/Classifications/dirty_goods_hs6.csv", clear
(encoding automatically selected: ISO-8859-2)
(3 vars, 1,139 obs)

. keep hs6 dirty

. rename dirty dirty_p

. tempfile dirty

. save `dirty'
file C:\Users\edodr\AppData\Local\Temp\ST_21c_000002.tmp saved as .dta format

. 
. global F_GREEN "`green'"

. global F_DIRTY "`dirty'"

. 
. *── Programma: stima sub-indici per un depth ────────────────────────────────
> ──
. capture program drop subind_one_depth

. program define subind_one_depth
  1.     args depthfile depthvar drop_unmeasured outfile
  2. 
.     capture confirm file "`outfile'"
  3.     if !_rc {
  4.         di as text "[skip] `outfile' esiste gia'."
  5.         exit
  6.     }
  7. 
.     di as result _n "========================================================
> ===="
  8.     di as result "  Sub-indici full panel — depth: `depthvar'"
  9.     di as result "========================================================
> ===="
 10. 
.     timer clear 1
 11.     timer on 1
 12. 
.     * --- Depth ---
.     import delimited "`depthfile'", clear
 13.     keep country_code year `depthvar'
 14.     tempfile depth
 15.     save `depth'
 16. 
.     * --- Sub-index source ---
.     import delimited "$ROOT/Data/Merged/Merged_TREND_WB_Indices_Only.csv", cl
> ear case(preserve)
 17.     keep country_code year ///
>         WB_GreenLiberalization TREND_GreenMarketAccess ///
>         WB_EnforcementDSM TREND_EnforcementDSM ///
>         TREND_Hard TREND_Soft TREND_RegulatorySpace
 18.     tempfile subidx
 19.     save `subidx'
 20. 
.     * --- Carica panel ---
.     use ln_export hs6 country_code year fpd fdt pt ///
>         using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_compres
> sed.dta", clear
 21. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 22.     keep if !hkmo
 23.     drop hkmo
 24. 
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 25.     drop _merge
 26.     replace env_good = 0 if missing(env_good)
 27. 
.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 28.     drop _merge
 29.     replace dirty_p = 0 if missing(dirty_p)
 30. 
.     merge m:1 country_code year using `depth', keep(master match)
 31.     drop _merge
 32.     if `drop_unmeasured' {
 33.         * no WB_EP_Depth in memory — approximate: drop if depth missing & 
> year >= 2001
.         * (conservative; the variable would be >0 only for treated obs)
.     }
 34.     replace `depthvar' = 0 if missing(`depthvar')
 35. 
.     merge m:1 country_code year using `subidx', keep(master match) nogen
 36. 
.     drop hs6
 37. 
.     count
 38.     di "  Obs dopo merge: " r(N)
 39. 
.     * --- CSV header ---
.     file open fh using "`outfile'", write replace text
 40.     file write fh "sub_index,term,coef,se,pval,r2_a,nobs" _n
 41.     file close fh
 42. 
.     * --- Loop sui 7 sotto-indici ---
.     foreach s in WB_GreenLiberalization TREND_GreenMarketAccess ///
>                  WB_EnforcementDSM TREND_EnforcementDSM ///
>                  TREND_Hard TREND_Soft TREND_RegulatorySpace {
 43. 
.         cap drop sub_green sub_dirty td_green td_dirty
 44.         qui gen double sub_green = `s' * env_good
 45.         qui gen double sub_dirty = `s' * dirty_p
 46.         qui gen double td_green  = `depthvar' * env_good
 47.         qui gen double td_dirty  = `depthvar' * dirty_p
 48. 
.         cap qui reghdfe ln_export sub_green sub_dirty td_green td_dirty, ///
>             absorb(fpd fdt pt) vce(cluster country_code) compact
 49.         if _rc {
 50.             di as error "  [`s'] stima fallita (rc=" _rc ")"
 51.             continue
 52.         }
 53. 
.         local NN   = e(N)
 54.         local r2a  = e(r2_a)
 55.         di as res "  [`s'] sub_green=" %10.7f _b[sub_green] "  sub_dirty="
>  %10.7f _b[sub_dirty] "  r2a=" %8.6f `r2a'
 56. 
.         foreach v in sub_green sub_dirty {
 57.             if "`v'" == "sub_green" local tn "SUB:env_good"
 58.             if "`v'" == "sub_dirty" local tn "SUB:dirty_p"
 59.             local b  = _b[`v']
 60.             local se = _se[`v']
 61.             local p  = 2 * ttail(e(df_r), abs(`b'/`se'))
 62.             file open fh using "`outfile'", write append text
 63.             file write fh "`s',`tn',`b',`se',`p',`r2a',`NN'" _n
 64.             file close fh
 65.         }
 66.     }
 67. 
.     timer off 1
 68.     qui timer list 1
 69.     di as result "  -> completato in " r(t1)/60 " minuti"
 70. end

. 
