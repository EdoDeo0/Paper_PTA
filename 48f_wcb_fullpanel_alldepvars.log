. ************************************************************
. * Programma: stima WCB per una outcome (Frisch-Waugh)
. ************************************************************
. capture program drop wcb_one_outcome

. program define wcb_one_outcome
  1.     args outcome_var raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  WCB per `outcome_label' ($PTA_DEPTH)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     * --- Carica dati ---
.     if "`raw_var'" == "exp_qua" {
  8.         use exp_qua WB_EP_Depth TREND_EP_Count hs6 country_code year fpd f
> dt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
  9.         gen double `outcome_var' = ln(exp_qua)
 10.         drop exp_qua
 11.         drop if missing(`outcome_var')
 12.     }
 13.     else if "`raw_var'" == "uv_exp" {
 14.         use uv_exp WB_EP_Depth TREND_EP_Count hs6 country_code year fpd fd
> t pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 15.         gen double `outcome_var' = ln(uv_exp)
 16.         drop uv_exp
 17.         drop if missing(`outcome_var')
 18.     }
 19. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 20.     keep if $HKMOEXPR
 21.     drop hkmo
 22. 
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 23.     drop _merge
 24.     replace env_good_new = 0 if missing(env_good_new)
 25.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 26.     drop _merge
 27.     replace dirty_p = 0 if missing(dirty_p)
 28.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 29.     drop _merge
 30.     if $DROP_UNMEASURED {
 31.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 32.     }
 33.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 34. 
.     gen double wb_green = WB_EP_Depth    * env_good_new
 35.     gen double wb_dirty = WB_EP_Depth    * dirty_p
 36.     gen double tr_green = TREND_EP_Count * env_good_new
 37.     gen double tr_dirty = TREND_EP_Count * dirty_p
 38.     gen double td_green = $DEPTHVAR * env_good_new
 39.     gen double td_dirty = $DEPTHVAR * dirty_p
 40.     drop WB_EP_Depth TREND_EP_Count env_good_new dirty_p $DEPTHVAR hs6
 41. 
.     count
 42.     local N_raw = r(N)
 43.     di "  Righe caricate: `N_raw'"
 44. 
.     * --- FASE 1: demeaning ---
.     di as txt "  [demeaning] `outcome_var'..."
 45.     local dmvars `outcome_var' wb_green wb_dirty tr_green tr_dirty td_gree
> n td_dirty
 46.     foreach v of local dmvars {
 47.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
 48.     }
 49.     keep *_dm country_code
 50.     local nobs = _N
 51.     qui levelsof country_code, local(cclist)
 52.     local nclust : word count `cclist'
 53. 
.     * --- FASE 2: WB reg + boottest ---
.     di as txt "  [WB] OLS + boottest..."
 54.     reg `outcome_var'_dm wb_green_dm wb_dirty_dm td_green_dm td_dirty_dm, 
> cluster(country_code) nocons
 55.     local nobs   = e(N)
 56.     local nclust = e(N_clust)
 57. 
.     local coef_wb_green = _b[wb_green_dm]
 58.     local coef_wb_dirty = _b[wb_dirty_dm]
 59. 
.     di as txt "    boottest WB_green..."
 60.     boottest wb_green_dm, boottype(wild) reps(9999) seed(42) noci
 61.     local p_wb_green = r(p)
 62.     di as txt "    p_boot WB_green = `p_wb_green'"
 63. 
.     di as txt "    boottest WB_dirty..."
 64.     boottest wb_dirty_dm, boottype(wild) reps(9999) seed(42) noci
 65.     local p_wb_dirty = r(p)
 66.     di as txt "    p_boot WB_dirty = `p_wb_dirty'"
 67. 
.     boottest wb_green_dm, boottype(wild) reps(9999) seed(42)
 68.     local ci_low_wg  = r(CI)[1,1]
 69.     local ci_high_wg = r(CI)[1,2]
 70.     boottest wb_dirty_dm, boottype(wild) reps(9999) seed(42)
 71.     local ci_low_wd  = r(CI)[1,1]
 72.     local ci_high_wd = r(CI)[1,2]
 73. 
.     write_wcb_row "WB_green" `coef_wb_green' `p_wb_green' `ci_low_wg' `ci_hig
> h_wg' `nobs' `nclust' 9999 `outcome_label'
 74.     write_wcb_row "WB_dirty" `coef_wb_dirty' `p_wb_dirty' `ci_low_wd' `ci_
> high_wd' `nobs' `nclust' 9999 `outcome_label'
 75. 
.     * --- FASE 3: TREND reg + boottest ---
.     di as txt "  [TREND] OLS + boottest..."
 76.     reg `outcome_var'_dm tr_green_dm tr_dirty_dm td_green_dm td_dirty_dm, 
> cluster(country_code) nocons
 77.     local nobs   = e(N)
 78.     local nclust = e(N_clust)
 79. 
.     local coef_tr_green = _b[tr_green_dm]
 80.     local coef_tr_dirty = _b[tr_dirty_dm]
 81. 
.     di as txt "    boottest TREND_green..."
 82.     boottest tr_green_dm, boottype(wild) reps(9999) seed(42) noci
 83.     local p_tr_green = r(p)
 84.     di as txt "    p_boot TREND_green = `p_tr_green'"
 85. 
.     di as txt "    boottest TREND_dirty..."
 86.     boottest tr_dirty_dm, boottype(wild) reps(9999) seed(42) noci
 87.     local p_tr_dirty = r(p)
 88.     di as txt "    p_boot TREND_dirty = `p_tr_dirty'"
 89. 
.     boottest tr_green_dm, boottype(wild) reps(9999) seed(42)
 90.     local ci_low_tg  = r(CI)[1,1]
 91.     local ci_high_tg = r(CI)[1,2]
 92.     boottest tr_dirty_dm, boottype(wild) reps(9999) seed(42)
 93.     local ci_low_td  = r(CI)[1,1]
 94.     local ci_high_td = r(CI)[1,2]
 95. 
.     write_wcb_row "TREND_green" `coef_tr_green' `p_tr_green' `ci_low_tg' `ci_
> high_tg' `nobs' `nclust' 9999 `outcome_label'
 96.     write_wcb_row "TREND_dirty" `coef_tr_dirty' `p_tr_dirty' `ci_low_td' `
> ci_high_td' `nobs' `nclust' 9999 `outcome_label'
 97. 
.     timer off 1
 98.     qui timer list 1
 99.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
100. end

. 
. * Serve global per i tempfile nei merge dentro il program
. global F_GREEN "`green'"

. global F_DIRTY "`dirty'"

. global F_DEPTH "`depth'"

. 
