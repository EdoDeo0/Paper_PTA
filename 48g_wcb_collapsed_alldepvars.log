. 
. clear all

. set more off

. set varabbrev off

. 
. if c(os) == "Windows" {
.     global ROOT "C:\Work\projects\Paper_PTA"
. }

. else if c(os) == "MacOSX" {
.     global ROOT "~/Documents/work/projects/Paper_PTA"
. }

. else {
