* = FE nested within cluster; treated as redundant for DoF computation

. local nobs   = e(N)

. local nclust = e(N_clust)

. foreach v in low_g med_g high_g low_d med_d high_d {
  2.     local b_`v'  = _b[`v']
  3.     local se_`v' = _se[`v']
  4. }

. 
. * --- FWL demeaning ---------------------------------------------------------
> --
. di as txt "demeaning..."
demeaning...

. local dmvars y low_g med_g high_g low_d med_d high_d td_g td_d

. foreach v of local dmvars {
  2.     cap drop `v'_dm
  3.     qui reghdfe `v' [aw=n], absorb(pd dt pt) residuals(`v'_dm) tol(1e-8)
  4. }

. 
. qui reg y_dm low_g_dm med_g_dm high_g_dm low_d_dm med_d_dm high_d_dm td_g_dm 
> td_d_dm [aw=n], ///
>     cluster(country_code) nocons

. 
. * --- Guardia di riproduzione (FWL deve coincidere col reghdfe asintotico) --
> -
. foreach v in low_g med_g high_g low_d med_d high_d {
  2.     local b_fwl = _b[`v'_dm]
  3.     if abs(`b_fwl' - `b_`v'') > 1e-4 {
  4.         di as error "GUARDIA FALLITA su `v': reghdfe=`b_`v'' FWL=`b_fwl'"
  5.         exit 9
  6.     }
  7. }

. di as result "[guardia OK] FWL riproduce reghdfe entro 1e-4 su tutte le 6 fas
> ce"
[guardia OK] FWL riproduce reghdfe entro 1e-4 su tutte le 6 fasce

. 
. * --- Scrittura CSV coefficienti asintotici ---------------------------------
> --
. global CSV "$OUTD/dosebins_wcb_stata.csv"

. file open fh using "$CSV", write replace text
(file
    C:/Work/projects/Paper_PTA/New/replication/audit_2026-09-07c/dosebins_wcb
    > _stata.csv not found)

. file write fh "fascia,coef,se,pval,nobs,nclust" _n

. foreach v in low_g med_g high_g low_d med_d high_d {
  2.     local p  = 2*ttail(`nclust'-1, abs(`b_`v''/`se_`v''))
  3.     file write fh "`v'," (`b_`v'') "," (`se_`v'') "," (`p') "," (`nobs') "
> ," (`nclust') _n
  4. }

. file close fh

. 
. * --- boottest sulle fasce bassa e media (green e dirty), 4 chiamate --------
> -
. di as result _n "=== boottest (4 chiamate: low_g, med_g, low_d, med_d) ==="

=== boottest (4 chiamate: low_g, med_g, low_d, med_d) ===

. global CSVW "$OUTD/dosebins_wcb_pvalues.csv"

. file open fw using "$CSVW", write replace text
(file
    C:/Work/projects/Paper_PTA/New/replication/audit_2026-09-07c/dosebins_wcb
    > _pvalues.csv not found)

. file write fw "var,p_wcb,ci_lo,ci_hi" _n

. file close fw

. foreach v in low_g med_g low_d med_d {
  2.     di as text "  boottest su `v'_dm..."
  3.     set seed 42
  4.     boottest `v'_dm, reps(9999) cluster(country_code) nograph
  5.     local pw = r(p)
  6.     local cilo = r(CI)[1,1]
  7.     local cihi = r(CI)[1,2]
  8.     file open fw using "$CSVW", write append text
  9.     file write fw "`v'," (`pw') "," (`cilo') "," (`cihi') _n
 10.     file close fw
 11. }
