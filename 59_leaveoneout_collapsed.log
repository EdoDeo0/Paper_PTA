. *── Program: una stima -> LOO_<label>.dta ───────────────────────────────────
> ───
. capture program drop run_loo

. program define run_loo
  1.     args label dvar ifexpr dropped
  2.     local out "$TAB\LOO_`label'.dta"
  3.     cap confirm file "`out'"
  4.     if _rc == 0 {
  5.         di as text "  SKIP `label' (gia' presente)"
  6.         exit 0
  7.     }
  8.     local epd = cond("`dvar'" == "ext", "ep_dirty_ext", "ep_dirty")
  9.     local tdd = cond("`dvar'" == "ext", "td_dirty_ext", "td_dirty")
 10.     di as text "  [`label'] reghdfe..."
 11.     cap noisily reghdfe y ep_green `epd' td_green `tdd' [aw=n] `ifexpr', /
> //
>         absorb(pd dt pt) vce(cluster country_code)
 12.     if _rc {
 13.         di as error "  [FALLITO] `label'"
 14.         exit 0
 15.     }
 16.     regsave using "`out'", tstat pval ci replace ///
>         addlabel(spec, `label', dropped_country, "`dropped'", ///
>                  source, reghdfe_stata_59)
 17.     di as text "  `label': dirty=" %9.5f _b[`epd'] "  green=" %9.5f _b[ep_
> green]
 18. end

