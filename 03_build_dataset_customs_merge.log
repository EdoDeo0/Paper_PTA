  variable hs6 was double now long
  variable TREND_EP_Count was double now byte
  variable TREND_EP_Count_Binary was double now byte
  variable TREND_Soft was double now byte
  variable TREND_Hard was double now byte
  variable TREND_EnforcementDSM was double now byte
  variable TREND_RegulatorySpace was double now byte
  variable TREND_GreenMarketAccess was double now byte
  variable TREND_ClimateEnergy was double now byte
  variable TREND_BiodivForestsFisheries was double now byte
  variable WB_EP_Depth was double now byte
  variable WB_EP_Depth_Binary was double now byte
  variable WB_StandardsNonRegression was double now byte
  variable WB_EnforcementDSM was double now byte
  variable WB_RegulatorySpaceExceptions was double now byte
  variable N_TREND_available was double now int
  variable N_WB_available was double now byte
