.     * programma: stima e scrive una riga
.     capture program drop loo_row
.     program define loo_row
  1.         * `dvar' = regressore dirty (ep_dirty o ep_dirty_ext)
.         * `tvar' = controllo di profondita' abbinato (td_dirty o td_dirty_ext
> )
.         args csv spec dropped dvar tvar
  2.         qui reghdfe y ep_green `dvar' td_green `tvar' ///
>             [aw=n], absorb(pd dt pt) vce(cluster country_code)
  3.         local NN  = e(N)
  4.         local NCL = e(N_clust)
  5.         local bd  = _b[`dvar']
  6.         local sd  = _se[`dvar']
  7.         local pd_ = 2 * ttail(e(df_r), abs(`bd'/`sd'))
  8.         local bg  = _b[ep_green]
  9.         local sg  = _se[ep_green]
 10.         local pg  = 2 * ttail(e(df_r), abs(`bg'/`sg'))
 11.         file open fh using "`csv'", write append text
 12.         file write fh "`spec',`dropped',`bd',`sd',`pd_',`bg',`sg',`pg',`NN
> ',`NCL',pd+dt+pt" _n
 13.         file close fh
 14.         di as res "  [E `spec'] dirty=" %10.7f `bd' "  green=" %10.7f `bg'
>  "  N=" `NN'
 15.     end
. 
