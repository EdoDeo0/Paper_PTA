. * BLOCCO A - baseline collassato  ->  tripledd_collapsed{sfx}.csv
. *   schema R: treat,term,coef,se,pval,nobs
. *****************************************************************************
> ***
. local outA "$TAB\tripledd_collapsed$SFX.csv"

. capture confirm file "`outA'"

. if _rc {
.     load_variant
