. *── Programma: stima sub-indici per un depth ────────────────────────────────
> ──
. capture program drop subind_one_depth

. program define subind_one_depth
  1.     args depthfile depthvar drop_unmeasured outfile
  2. 
.     capture confirm file "`outfile'"
  3.     if !_rc {
  4.         di as text "[skip] `outfile' esiste gia'."
  5.         exit
  6.     }
  7. 
.     di as result _n "========================================================
> ===="
  8.     di as result "  Sub-indici full panel — depth: `depthvar'"
  9.     di as result "========================================================
> ===="
 10. 
.     timer clear 1
 11.     timer on 1
 12. 
.     * --- Depth ---
.     import delimited "`depthfile'", clear
 13.     keep country_code year `depthvar'
 14.     tempfile depth
 15.     save `depth'
 16. 
.     * --- Sub-index source ---
.     import delimited "$ROOT/Data/Merged/Merged_TREND_WB_Indices_Only.csv", cl
> ear case(preserve)
 17.     keep country_code year ///
>         WB_GreenLiberalization TREND_GreenMarketAccess ///
>         WB_EnforcementDSM TREND_EnforcementDSM ///
>         TREND_Hard TREND_Soft TREND_RegulatorySpace
 18.     tempfile subidx
 19.     save `subidx'
 20. 
.     * --- Carica panel ---
.     use ln_export hs6 country_code year fpd fdt pt ///
>         using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_compres
> sed.dta", clear
 21. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 22.     keep if !hkmo
 23.     drop hkmo
 24. 
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 25.     drop _merge
 26.     replace env_good = 0 if missing(env_good)
 27. 
.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 28.     drop _merge
 29.     replace dirty_p = 0 if missing(dirty_p)
 30. 
.     merge m:1 country_code year using `depth', keep(master match)
 31.     drop _merge
 32.     if `drop_unmeasured' {
 33.         * no WB_EP_Depth in memory — approximate: drop if depth missing & 
> year >= 2001
.         * (conservative; the variable would be >0 only for treated obs)
.     }
 34.     replace `depthvar' = 0 if missing(`depthvar')
 35. 
.     * Keep all obs; sub-index = 0 for non-PTA countries (mirrors collapsed sp
> ec in 63)
.     merge m:1 country_code year using `subidx', nogen
 36.     foreach s in WB_GreenLiberalization TREND_GreenMarketAccess ///
>                  WB_EnforcementDSM TREND_EnforcementDSM ///
>                  TREND_Hard TREND_Soft TREND_RegulatorySpace {
 37.         replace `s' = 0 if missing(`s')
 38.     }
 39. 
.     drop hs6
 40. 
.     count
 41.     di "  Obs dopo merge: " r(N)
 42. 
.     * --- CSV header ---
.     file open fh using "`outfile'", write replace text
 43.     file write fh "sub_index,term,coef,se,pval,r2_a,nobs,nclust" _n
 44.     file close fh
 45. 
.     * --- Loop sui 7 sotto-indici ---
.     foreach s in WB_GreenLiberalization TREND_GreenMarketAccess ///
>                  WB_EnforcementDSM TREND_EnforcementDSM ///
>                  TREND_Hard TREND_Soft TREND_RegulatorySpace {
 46. 
.         cap drop sub_green sub_dirty td_green td_dirty
 47.         qui gen double sub_green = `s' * env_good
 48.         qui gen double sub_dirty = `s' * dirty_p
 49.         qui gen double td_green  = `depthvar' * env_good
 50.         qui gen double td_dirty  = `depthvar' * dirty_p
 51. 
.         cap qui reghdfe ln_export sub_green sub_dirty td_green td_dirty, ///
>             absorb(fpd fdt pt) vce(cluster country_code) compact
 52.         if _rc {
 53.             di as error "  [`s'] stima fallita (rc=" _rc ")"
 54.             continue
 55.         }
 56. 
.         local NN     = e(N)
 57.         local nclust = e(N_clust)
 58.         local r2a    = e(r2_a)
 59.         di as res "  [`s'] sub_green=" %10.7f _b[sub_green] "  sub_dirty="
>  %10.7f _b[sub_dirty] "  r2a=" %8.6f `r2a'
 60. 
.         foreach v in sub_green sub_dirty {
 61.             if "`v'" == "sub_green" local tn "SUB:env_good"
 62.             if "`v'" == "sub_dirty" local tn "SUB:dirty_p"
 63.             local b  = _b[`v']
 64.             local se = _se[`v']
 65.             local p  = 2 * ttail(e(df_r), abs(`b'/`se'))
 66.             file open fh using "`outfile'", write append text
 67.             file write fh "`s',`tn',`b',`se',`p',`r2a',`NN',`nclust'" _n
 68.             file close fh
 69.         }
 70.     }
 71. 
.     timer off 1
 72.     qui timer list 1
 73.     di as result "  -> completato in " r(t1)/60 " minuti"
 74. end

