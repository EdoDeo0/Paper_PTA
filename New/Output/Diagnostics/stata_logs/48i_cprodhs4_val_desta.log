. ************************************************************
. * Programma: stima C-prod-HS4 per una outcome
. ************************************************************
. capture program drop cprodhs4_one_outcome

. program define cprodhs4_one_outcome
  1.     args raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  C-prod-HS4: `outcome_label' ($PTA_DEPTH)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     * --- Carica dati ---
.     if "`raw_var'" == "ln_export" {
  8.         use ln_export WB_EP_Depth TREND_EP_Count hs6 country_code year fpd
>  fdt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
  9.         gen double ln_y = ln_export
 10.         drop ln_export
 11.         drop if missing(ln_y)
 12.     }
 13.     else if "`raw_var'" == "exp_qua" {
 14.         use exp_qua WB_EP_Depth TREND_EP_Count hs6 country_code year fpd f
> dt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 15.         gen double ln_y = ln(exp_qua)
 16.         drop exp_qua
 17.         drop if missing(ln_y)
 18.     }
 19.     else if "`raw_var'" == "uv_exp" {
 20.         use uv_exp WB_EP_Depth TREND_EP_Count hs6 country_code year fpd fd
> t pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 21.         gen double ln_y = ln(uv_exp)
 22.         drop uv_exp
 23.         drop if missing(ln_y)
 24.     }
 25. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 26.     keep if $HKMOEXPR
 27.     drop hkmo
 28. 
.     * --- Filtro C-prod-HS4 ---
.     merge m:1 hs6 using "$F_HS4", keep(master match) nogen
 29.     keep if keep_hs4 == 1
 30.     drop keep_hs4
 31.     count
 32.     di "  Righe dopo filtro prodHS4: " r(N)
 33. 
.     * --- Merge classificazioni ---
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 34.     drop _merge
 35.     replace env_good_new = 0 if missing(env_good_new)
 36.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 37.     drop _merge
 38.     replace dirty_p = 0 if missing(dirty_p)
 39.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 40.     drop _merge
 41.     if $DROP_UNMEASURED {
 42.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 43.     }
 44.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 45. 
.     gen double wb_green = WB_EP_Depth    * env_good_new
 46.     gen double wb_dirty = WB_EP_Depth    * dirty_p
 47.     gen double tr_green = TREND_EP_Count * env_good_new
 48.     gen double tr_dirty = TREND_EP_Count * dirty_p
 49.     gen double td_green = $DEPTHVAR * env_good_new
 50.     gen double td_dirty = $DEPTHVAR * dirty_p
 51.     drop WB_EP_Depth TREND_EP_Count env_good_new dirty_p $DEPTHVAR hs6
 52. 
.     count
 53.     local N_raw = r(N)
 54.     di "  Righe finali: `N_raw'"
 55. 
.     * --- WB: reghdfe asintotico ---
.     di as txt "  [WB] reghdfe fpd+fdt+pt..."
 56.     reghdfe ln_y wb_green wb_dirty td_green td_dirty, ///
>         absorb(fpd fdt pt) vce(cluster country_code) compact
 57.     local nobs   = e(N)
 58.     local nclust = e(N_clust)
 59.     local r2a    = e(r2_a)
 60. 
.     local b_wg = _b[wb_green]
 61.     local b_wd = _b[wb_dirty]
 62.     local se_wg = _se[wb_green]
 63.     local se_wd = _se[wb_dirty]
 64.     local p_wg = 2*ttail(`nclust'-1, abs(`b_wg'/`se_wg'))
 65.     local p_wd = 2*ttail(`nclust'-1, abs(`b_wd'/`se_wd'))
 66. 
.     * FWL demeaning
.     di as txt "  [WB] demeaning per boottest..."
 67.     local dmvars ln_y wb_green wb_dirty td_green td_dirty
 68.     foreach v of local dmvars {
 69.         cap drop `v'_dm
 70.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
 71.     }
 72. 
.     qui reg ln_y_dm wb_green_dm wb_dirty_dm td_green_dm td_dirty_dm, cluster(
> country_code) nocons
 73. 
.     di as txt "    boottest WB_green..."
 74.     set seed 42
 75.     boottest wb_green_dm, boottype(wild) reps(9999) noci
 76.     local pwcb_wg = r(p)
 77.     set seed 42
 78.     boottest wb_green_dm, boottype(wild) reps(9999)
 79.     local ci_wg_lo = r(CI)[1,1]
 80.     local ci_wg_hi = r(CI)[1,2]
 81. 
.     di as txt "    boottest WB_dirty..."
 82.     set seed 42
 83.     boottest wb_dirty_dm, boottype(wild) reps(9999) noci
 84.     local pwcb_wd = r(p)
 85.     set seed 42
 86.     boottest wb_dirty_dm, boottype(wild) reps(9999)
 87.     local ci_wd_lo = r(CI)[1,1]
 88.     local ci_wd_hi = r(CI)[1,2]
 89. 
.     write_row "WB_green" wb_green `b_wg' `se_wg' `p_wg' `pwcb_wg' `ci_wg_lo' 
> `ci_wg_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
 90.     write_row "WB_dirty" wb_dirty `b_wd' `se_wd' `p_wd' `pwcb_wd' `ci_wd_l
> o' `ci_wd_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
 91. 
.     * --- TREND: reghdfe asintotico ---
.     di as txt "  [TREND] reghdfe fpd+fdt+pt..."
 92.     reghdfe ln_y tr_green tr_dirty td_green td_dirty, ///
>         absorb(fpd fdt pt) vce(cluster country_code) compact
 93.     local nobs   = e(N)
 94.     local nclust = e(N_clust)
 95.     local r2a    = e(r2_a)
 96. 
.     local b_tg = _b[tr_green]
 97.     local b_td = _b[tr_dirty]
 98.     local se_tg = _se[tr_green]
 99.     local se_td = _se[tr_dirty]
100.     local p_tg = 2*ttail(`nclust'-1, abs(`b_tg'/`se_tg'))
101.     local p_td = 2*ttail(`nclust'-1, abs(`b_td'/`se_td'))
102. 
.     di as txt "  [TREND] demeaning per boottest..."
103.     foreach v in ln_y tr_green tr_dirty td_green td_dirty {
104.         cap drop `v'_dm
105.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
106.     }
107. 
.     qui reg ln_y_dm tr_green_dm tr_dirty_dm td_green_dm td_dirty_dm, cluster(
> country_code) nocons
108. 
.     di as txt "    boottest TREND_green..."
109.     set seed 42
110.     boottest tr_green_dm, boottype(wild) reps(9999) noci
111.     local pwcb_tg = r(p)
112.     set seed 42
113.     boottest tr_green_dm, boottype(wild) reps(9999)
114.     local ci_tg_lo = r(CI)[1,1]
115.     local ci_tg_hi = r(CI)[1,2]
116. 
.     di as txt "    boottest TREND_dirty..."
117.     set seed 42
118.     boottest tr_dirty_dm, boottype(wild) reps(9999) noci
119.     local pwcb_td = r(p)
120.     set seed 42
121.     boottest tr_dirty_dm, boottype(wild) reps(9999)
122.     local ci_td_lo = r(CI)[1,1]
123.     local ci_td_hi = r(CI)[1,2]
124. 
.     write_row "TREND_green" tr_green `b_tg' `se_tg' `p_tg' `pwcb_tg' `ci_tg_l
> o' `ci_tg_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
125.     write_row "TREND_dirty" tr_dirty `b_td' `se_td' `p_td' `pwcb_td' `ci_t
> d_lo' `ci_td_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
126. 
.     timer off 1
127.     qui timer list 1
128.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
129. end

. 
. ************************************************************
. * Esecuzione
. ************************************************************
