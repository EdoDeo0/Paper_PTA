. ************************************************************
. * Programma: stima collapsed per una outcome
. ************************************************************
. capture program drop collapsed_one_outcome

. program define collapsed_one_outcome
  1.     args raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  Collapsed panel: `outcome_label' ($PTA_DEPTH)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     * --- Carica dati raw ---
.     use `raw_var' WB_EP_Depth TREND_EP_Count hs6 country_code year ///
>         using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_compres
> sed.dta", clear
  8. 
.     gen byte hkmo = inlist(country_code, 110, 121)
  9.     keep if $HKMOEXPR
 10.     drop hkmo
 11. 
.     drop if missing(`raw_var')
 12. 
.     * --- Collassa a HS6 x dest x year ---
.     gen double y_raw = `raw_var'
 13.     if "`raw_var'" == "exp_qua" {
 14.         gen double y = ln(exp_qua)
 15.     }
 16.     else if "`raw_var'" == "uv_exp" {
 17.         gen double y = ln(uv_exp)
 18.     }
 19.     drop if missing(y)
 20. 
.     collapse (mean) y (count) n=y_raw (first) WB_EP_Depth TREND_EP_Count, ///
>         by(hs6 country_code year)
 21.     di "  Celle dopo collapse: " _N
 22. 
.     * --- Merge classificazioni ---
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 23.     drop _merge
 24.     replace env_good_new = 0 if missing(env_good_new)
 25.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 26.     drop _merge
 27.     replace dirty_p = 0 if missing(dirty_p)
 28.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 29.     drop _merge
 30.     if $DROP_UNMEASURED {
 31.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 32.     }
 33.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 34. 
.     gen double wb_green = WB_EP_Depth    * env_good_new
 35.     gen double wb_dirty = WB_EP_Depth    * dirty_p
 36.     gen double tr_green = TREND_EP_Count * env_good_new
 37.     gen double tr_dirty = TREND_EP_Count * dirty_p
 38.     gen double td_green = $DEPTHVAR * env_good_new
 39.     gen double td_dirty = $DEPTHVAR * dirty_p
 40. 
.     * FE collassati
.     egen long pd = group(hs6 country_code)
 41.     egen long dt = group(country_code year)
 42.     egen long pt = group(hs6 year)
 43. 
.     drop WB_EP_Depth TREND_EP_Count env_good_new dirty_p $DEPTHVAR hs6
 44. 
.     count
 45.     local N_cells = r(N)
 46.     di "  Celle finali: `N_cells'"
 47. 
.     * --- REGHDFE asintotici + FWL + boottest per WB ---
.     di as txt "  [WB] reghdfe asintotico..."
 48.     reghdfe y wb_green wb_dirty td_green td_dirty [aw=n], ///
>         absorb(pd dt pt) vce(cluster country_code)
 49.     local nobs   = e(N)
 50.     local nclust = e(N_clust)
 51.     local r2a    = e(r2_a)
 52. 
.     local b_wg = _b[wb_green]
 53.     local b_wd = _b[wb_dirty]
 54.     local se_wg = _se[wb_green]
 55.     local se_wd = _se[wb_dirty]
 56.     local p_wg = 2*ttail(`nclust'-1, abs(`b_wg'/`se_wg'))
 57.     local p_wd = 2*ttail(`nclust'-1, abs(`b_wd'/`se_wd'))
 58. 
.     * FWL demeaning per boottest
.     di as txt "  [WB] demeaning..."
 59.     local dmvars y wb_green wb_dirty td_green td_dirty
 60.     foreach v of local dmvars {
 61.         cap drop `v'_dm
 62.         qui reghdfe `v' [aw=n], absorb(pd dt pt) residuals(`v'_dm) tol(1e-
> 8)
 63.     }
 64. 
.     qui reg y_dm wb_green_dm wb_dirty_dm td_green_dm td_dirty_dm [aw=n], clus
> ter(country_code) nocons
 65. 
.     di as txt "    boottest WB_green..."
 66.     set seed 42
 67.     boottest wb_green_dm, reps(9999) cluster(country_code) nograph
 68.     local pwcb_wg = r(p)
 69.     local ci_wg_lo = r(CI)[1,1]
 70.     local ci_wg_hi = r(CI)[1,2]
 71. 
.     di as txt "    boottest WB_dirty..."
 72.     set seed 42
 73.     boottest wb_dirty_dm, reps(9999) cluster(country_code) nograph
 74.     local pwcb_wd = r(p)
 75.     local ci_wd_lo = r(CI)[1,1]
 76.     local ci_wd_hi = r(CI)[1,2]
 77. 
.     write_row "WB_green" wb_green `b_wg' `se_wg' `p_wg' `pwcb_wg' `ci_wg_lo' 
> `ci_wg_hi' `nobs' `nclust' 9999 `outcome_label'
 78.     write_row "WB_dirty" wb_dirty `b_wd' `se_wd' `p_wd' `pwcb_wd' `ci_wd_l
> o' `ci_wd_hi' `nobs' `nclust' 9999 `outcome_label'
 79. 
.     * --- REGHDFE asintotici + FWL + boottest per TREND ---
.     di as txt "  [TREND] reghdfe asintotico..."
 80.     reghdfe y tr_green tr_dirty td_green td_dirty [aw=n], ///
>         absorb(pd dt pt) vce(cluster country_code)
 81.     local nobs   = e(N)
 82.     local nclust = e(N_clust)
 83. 
.     local b_tg = _b[tr_green]
 84.     local b_td = _b[tr_dirty]
 85.     local se_tg = _se[tr_green]
 86.     local se_td = _se[tr_dirty]
 87.     local p_tg = 2*ttail(`nclust'-1, abs(`b_tg'/`se_tg'))
 88.     local p_td = 2*ttail(`nclust'-1, abs(`b_td'/`se_td'))
 89. 
.     di as txt "  [TREND] demeaning..."
 90.     foreach v in y tr_green tr_dirty td_green td_dirty {
 91.         cap drop `v'_dm
 92.         qui reghdfe `v' [aw=n], absorb(pd dt pt) residuals(`v'_dm) tol(1e-
> 8)
 93.     }
 94. 
.     qui reg y_dm tr_green_dm tr_dirty_dm td_green_dm td_dirty_dm [aw=n], clus
> ter(country_code) nocons
 95. 
.     di as txt "    boottest TREND_green..."
 96.     set seed 42
 97.     boottest tr_green_dm, reps(9999) cluster(country_code) nograph
 98.     local pwcb_tg = r(p)
 99.     local ci_tg_lo = r(CI)[1,1]
100.     local ci_tg_hi = r(CI)[1,2]
101. 
.     di as txt "    boottest TREND_dirty..."
102.     set seed 42
103.     boottest tr_dirty_dm, reps(9999) cluster(country_code) nograph
104.     local pwcb_td = r(p)
105.     local ci_td_lo = r(CI)[1,1]
106.     local ci_td_hi = r(CI)[1,2]
107. 
.     write_row "TREND_green" tr_green `b_tg' `se_tg' `p_tg' `pwcb_tg' `ci_tg_l
> o' `ci_tg_hi' `nobs' `nclust' 9999 `outcome_label'
108.     write_row "TREND_dirty" tr_dirty `b_td' `se_td' `p_td' `pwcb_td' `ci_t
> d_lo' `ci_td_hi' `nobs' `nclust' 9999 `outcome_label'
109. 
.     timer off 1
110.     qui timer list 1
111.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
112. end

. 
. ************************************************************
. * Esecuzione
. ************************************************************
. di as result _n "*** 48g — Collapsed panel: quantity + unit value ***"

