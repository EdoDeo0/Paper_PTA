. ************************************************************
. * Programma: stima CO2 collapsed per una outcome
. ************************************************************
. capture program drop co2_one_outcome

. program define co2_one_outcome
  1.     args raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  CO2 collapsed: `outcome_label' ($PTA_DEPTH)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     use `raw_var' WB_EP_Depth TREND_EP_Count hs6 country_code year ///
>         using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_compres
> sed.dta", clear
  8. 
.     gen byte hkmo = inlist(country_code, 110, 121)
  9.     keep if $HKMOEXPR
 10.     drop hkmo
 11. 
.     drop if missing(`raw_var')
 12. 
.     if "`raw_var'" == "export" {
 13.         gen double y = ln(export)
 14.     }
 15.     else if "`raw_var'" == "exp_qua" {
 16.         gen double y = ln(exp_qua)
 17.     }
 18.     else if "`raw_var'" == "uv_exp" {
 19.         gen double y = ln(uv_exp)
 20.     }
 21.     drop if missing(y)
 22. 
.     collapse (mean) y (count) n=y (first) WB_EP_Depth TREND_EP_Count, ///
>         by(hs6 country_code year)
 23.     di "  Celle dopo collapse: " _N
 24. 
.     * Merge green
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 25.     drop _merge
 26.     replace env_good_new = 0 if missing(env_good_new)
 27. 
.     * Merge CO2 intensity
.     merge m:1 hs6 using "$F_CO2", keep(master match)
 28.     drop _merge
 29.     qui su co2_total
 30.     local mu = r(mean)
 31.     local sd = r(sd)
 32.     replace co2_total = `mu' if missing(co2_total)
 33.     gen double co2_z = (co2_total - `mu') / `sd'
 34.     drop co2_total
 35. 
.     * Merge depth
.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 36.     drop _merge
 37.     if $DROP_UNMEASURED {
 38.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 39.     }
 40.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 41. 
.     * FE collassati
.     egen long pd = group(hs6 country_code)
 42.     egen long dt = group(country_code year)
 43.     egen long pt = group(hs6 year)
 44. 
.     count
 45.     di "  Celle finali: " r(N)
 46. 
.     * --- Per ogni treat: reghdfe + FWL + boottest ---
.     foreach treat in WB TREND {
 47.         if "`treat'" == "WB"    local xv "WB_EP_Depth"
 48.         if "`treat'" == "TREND" local xv "TREND_EP_Count"
 49. 
.         cap drop ep_green ep_co2 td_green td_co2
 50.         qui gen double ep_green = `xv' * env_good_new
 51.         qui gen double ep_co2   = `xv' * co2_z
 52.         qui gen double td_green = $DEPTHVAR * env_good_new
 53.         qui gen double td_co2   = $DEPTHVAR * co2_z
 54. 
.         qui reghdfe y ep_green ep_co2 td_green td_co2 [aw=n], ///
>             absorb(pd dt pt) vce(cluster country_code)
 55.         local b_direct_ep_green = _b[ep_green]
 56.         local b_direct_ep_co2   = _b[ep_co2]
 57.         local NN  = e(N)
 58.         local NCL = e(N_clust)
 59. 
.         * FWL demeaning
.         foreach v in y ep_green ep_co2 td_green td_co2 {
 60.             cap drop `v'_dm
 61.             qui reghdfe `v' [aw=n], absorb(pd dt pt) residuals(`v'_dm) tol
> (1e-8)
 62.         }
 63.         qui reg y_dm ep_green_dm ep_co2_dm td_green_dm td_co2_dm [aw=n], /
> //
>             cluster(country_code) nocons
 64.         assert abs(_b[ep_green_dm] - `b_direct_ep_green') < 1e-6
 65.         assert abs(_b[ep_co2_dm] - `b_direct_ep_co2') < 1e-6
 66. 
.         foreach p in ep_green ep_co2 {
 67.             local b  = _b[`p'_dm]
 68.             local se = _se[`p'_dm]
 69.             local pa = 2 * ttail(`NCL'-1, abs(`b'/`se'))
 70.             set seed 42
 71.             cap boottest `p'_dm, reps(9999) cluster(country_code) nograph
 72.             if _rc {
 73.                 local pb = .
 74.                 local lo = .
 75.                 local hi = .
 76.             }
 77.             else {
 78.                 local pb = r(p)
 79.                 cap local lo = r(CI)[1,1]
 80.                 cap local hi = r(CI)[1,2]
 81.             }
 82.             di as res "  [CO2 `treat'] `p': coef=" %10.7f `b' "  p_wcb=" %
> 6.4f `pb'
 83.             wrow "$CSV_OUT" "`treat',`p',`b',`se',`pa',`pb',`lo',`hi',`NN'
> ,`NCL',9999,`outcome_label'"
 84.         }
 85.     }
 86. 
.     timer off 1
 87.     qui timer list 1
 88.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
 89. end

. 
