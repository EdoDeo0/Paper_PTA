. ************************************************************
. * Programma: FWL + boottest per una dep var
. ************************************************************
. capture program drop wcb_fullpanel_one

. program define wcb_fullpanel_one
  1.     args raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  WCB full panel inclHKMO: `outcome_label' ($PTA_DEPTH)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     * --- Carica panel (inclHKMO: non filtra) ---
.     if "`raw_var'" == "exp_qua" {
  8.         use exp_qua hs6 country_code year fpd fdt pt WB_EP_Depth TREND_EP_
> Count ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
  9.         drop if missing(exp_qua)
 10.         gen double y = ln(exp_qua)
 11.         drop exp_qua
 12.         drop if missing(y)
 13.     }
 14.     else if "`raw_var'" == "uv_exp" {
 15.         use uv_exp hs6 country_code year fpd fdt pt WB_EP_Depth TREND_EP_C
> ount ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 16.         drop if missing(uv_exp)
 17.         gen double y = ln(uv_exp)
 18.         drop uv_exp
 19.         drop if missing(y)
 20.     }
 21. 
.     * Merge green + dirty
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 22.     drop _merge
 23.     replace env_good = 0 if missing(env_good)
 24. 
.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 25.     drop _merge
 26.     replace dirty_p = 0 if missing(dirty_p)
 27. 
.     * Merge depth
.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 28.     drop _merge
 29.     if $DROP_UNMEASURED {
 30.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 31.     }
 32.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 33. 
.     drop hs6
 34. 
.     count
 35.     di "  Obs: " r(N)
 36. 
.     * --- Crea interazioni per entrambi i treat ---
.     qui gen double wb_green = WB_EP_Depth * env_good
 37.     qui gen double wb_dirty = WB_EP_Depth * dirty_p
 38.     qui gen double tr_green = TREND_EP_Count * env_good
 39.     qui gen double tr_dirty = TREND_EP_Count * dirty_p
 40.     qui gen double td_green = $DEPTHVAR * env_good
 41.     qui gen double td_dirty = $DEPTHVAR * dirty_p
 42. 
.     * --- FASE 1: FWL demeaning ---
.     di as txt "  Fase 1: demeaning..."
 43.     foreach v in y wb_green wb_dirty tr_green tr_dirty td_green td_dirty {
 44.         cap drop `v'_dm
 45.         di as txt "    `v'..."
 46.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
 47.     }
 48. 
.     * Salva demeaned in tempfile
.     tempfile dta_dm
 49.     preserve
 50.     keep y_dm wb_green_dm wb_dirty_dm tr_green_dm tr_dirty_dm td_green_dm 
> td_dirty_dm country_code
 51.     save `dta_dm'
 52.     restore
 53.     drop y wb_green wb_dirty tr_green tr_dirty td_green td_dirty
 54.     drop WB_EP_Depth TREND_EP_Count env_good dirty_p $DEPTHVAR fpd fdt pt
 55.     clear
 56. 
.     * --- FASE 2: WB ---
.     di as txt _n "  Fase 2: WB reg + boottest"
 57.     use `dta_dm', clear
 58. 
.     reg y_dm wb_green_dm wb_dirty_dm td_green_dm td_dirty_dm, cluster(country
> _code) nocons
 59.     local NN  = e(N)
 60.     local NCL = e(N_clust)
 61. 
.     foreach v in wb_green wb_dirty td_green td_dirty {
 62.         local coef_`v' = _b[`v'_dm]
 63.         local se_`v'   = _se[`v'_dm]
 64.         local p_`v'    = 2 * ttail(e(df_r), abs(_b[`v'_dm]/_se[`v'_dm]))
 65.     }
 66. 
.     foreach v in wb_green wb_dirty {
 67.         di as txt "    boottest `v'_dm..."
 68.         boottest `v'_dm, boottype(wild) reps(9999) seed(42) noci
 69.         local pb_`v' = r(p)
 70.     }
 71. 
.     foreach v in wb_green wb_dirty td_green td_dirty {
 72.         local pb = .
 73.         if "`v'" == "wb_green" local pb = `pb_wb_green'
 74.         if "`v'" == "wb_dirty" local pb = `pb_wb_dirty'
 75.         wrow "$CSV_OUT" "fullpanel_inclHKMO,WB,`v',`coef_`v'',`se_`v'',`p_
> `v'',`pb',9999,`NN',`NCL',`outcome_label'"
 76.     }
 77. 
.     * --- FASE 3: TREND ---
.     di as txt _n "  Fase 3: TREND reg + boottest"
 78.     use `dta_dm', clear
 79. 
.     reg y_dm tr_green_dm tr_dirty_dm td_green_dm td_dirty_dm, cluster(country
> _code) nocons
 80.     local NN  = e(N)
 81.     local NCL = e(N_clust)
 82. 
.     foreach v in tr_green tr_dirty td_green td_dirty {
 83.         local coef_`v' = _b[`v'_dm]
 84.         local se_`v'   = _se[`v'_dm]
 85.         local p_`v'    = 2 * ttail(e(df_r), abs(_b[`v'_dm]/_se[`v'_dm]))
 86.     }
 87. 
.     foreach v in tr_green tr_dirty {
 88.         di as txt "    boottest `v'_dm..."
 89.         boottest `v'_dm, boottype(wild) reps(9999) seed(42) noci
 90.         local pb_`v' = r(p)
 91.     }
 92. 
.     foreach v in tr_green tr_dirty td_green td_dirty {
 93.         local pb = .
 94.         if "`v'" == "tr_green" local pb = `pb_tr_green'
 95.         if "`v'" == "tr_dirty" local pb = `pb_tr_dirty'
 96.         wrow "$CSV_OUT" "fullpanel_inclHKMO,TREND,`v',`coef_`v'',`se_`v'',
> `p_`v'',`pb',9999,`NN',`NCL',`outcome_label'"
 97.     }
 98. 
.     timer off 1
 99.     qui timer list 1
100.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
101. end

. 
