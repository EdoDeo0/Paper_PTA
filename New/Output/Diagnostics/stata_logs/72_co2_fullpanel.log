. ************************************************************
. * Programma: CO2 FWL + boottest per una dep var
. ************************************************************
. capture program drop co2_fullpanel_one

. program define co2_fullpanel_one
  1.     args raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  CO2 full panel: `outcome_label' ($PTA_DEPTH, $PTA_SAMP
> LE)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     * --- Carica panel ---
.     if "`raw_var'" == "ln_export" {
  8.         use ln_export hs6 country_code year fpd fdt pt WB_EP_Depth TREND_E
> P_Count ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
  9.         rename ln_export y
 10.     }
 11.     else if "`raw_var'" == "exp_qua" {
 12.         use exp_qua hs6 country_code year fpd fdt pt WB_EP_Depth TREND_EP_
> Count ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 13.         drop if missing(exp_qua)
 14.         gen double y = ln(exp_qua)
 15.         drop exp_qua
 16.         drop if missing(y)
 17.     }
 18.     else if "`raw_var'" == "uv_exp" {
 19.         use uv_exp hs6 country_code year fpd fdt pt WB_EP_Depth TREND_EP_C
> ount ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 20.         drop if missing(uv_exp)
 21.         gen double y = ln(uv_exp)
 22.         drop uv_exp
 23.         drop if missing(y)
 24.     }
 25. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 26.     keep if $HKMOEXPR
 27.     drop hkmo
 28. 
.     * Merge green
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 29.     drop _merge
 30.     replace env_good = 0 if missing(env_good)
 31. 
.     * Merge CO2 intensity
.     merge m:1 hs6 using "$F_CO2", keep(master match)
 32.     drop _merge
 33.     qui su co2_total
 34.     local mu = r(mean)
 35.     local sd = r(sd)
 36.     replace co2_total = `mu' if missing(co2_total)
 37.     gen double co2_z = (co2_total - `mu') / `sd'
 38.     drop co2_total
 39. 
.     * Merge depth
.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 40.     drop _merge
 41.     if $DROP_UNMEASURED {
 42.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 43.     }
 44.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 45. 
.     drop hs6
 46. 
.     count
 47.     di "  Obs: " r(N)
 48. 
.     * --- Per ogni treat: FWL + boottest ---
.     foreach treat in WB TREND {
 49.         di as result _n "  --- `treat' ---"
 50. 
.         if "`treat'" == "WB"    local xv "WB_EP_Depth"
 51.         if "`treat'" == "TREND" local xv "TREND_EP_Count"
 52. 
.         cap drop ep_green ep_co2 td_green td_co2
 53.         qui gen double ep_green = `xv' * env_good
 54.         qui gen double ep_co2   = `xv' * co2_z
 55.         qui gen double td_green = $DEPTHVAR * env_good
 56.         qui gen double td_co2   = $DEPTHVAR * co2_z
 57. 
.         * FWL demeaning
.         foreach v in y ep_green ep_co2 td_green td_co2 {
 58.             cap drop `v'_dm
 59.             di as txt "    demeaning `v'..."
 60.             qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8
> )
 61.         }
 62. 
.         * OLS su demeaned
.         qui reg y_dm ep_green_dm ep_co2_dm td_green_dm td_co2_dm, ///
>             cluster(country_code) nocons
 63.         local NN  = e(N)
 64.         local NCL = e(N_clust)
 65. 
.         * Boottest per ep_green e ep_co2
.         foreach p in ep_green ep_co2 {
 66.             local b  = _b[`p'_dm]
 67.             local se = _se[`p'_dm]
 68.             local pa = 2 * ttail(e(df_r), abs(`b'/`se'))
 69.             di as txt "    boottest `p'_dm..."
 70.             set seed 42
 71.             cap boottest `p'_dm, boottype(wild) reps(9999) cluster(country
> _code) nograph
 72.             if _rc {
 73.                 local pb = .
 74.                 local lo = .
 75.                 local hi = .
 76.             }
 77.             else {
 78.                 local pb = r(p)
 79.                 cap local lo = r(CI)[1,1]
 80.                 cap local hi = r(CI)[1,2]
 81.             }
 82.             di as res "    [`treat'] `p': coef=" %10.7f `b' "  p_wcb=" %6.
> 4f `pb'
 83.             wrow "$CSV_OUT" "`treat',`p',`b',`se',`pa',`pb',`lo',`hi',`NN'
> ,`NCL',9999,`outcome_label'"
 84.         }
 85. 
.         cap drop ep_green ep_co2 td_green td_co2
 86.         cap drop y_dm ep_green_dm ep_co2_dm td_green_dm td_co2_dm
 87.     }
 88. 
.     timer off 1
 89.     qui timer list 1
 90.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
 91. end

. 
. ************************************************************
. * Esecuzione
. ************************************************************
