. *****************************************************************************
> ***
. ** Program: carica il full panel, applica il filtro del gruppo, stima WB+TREN
> D
. *****************************************************************************
> ***
. capture program drop run_stability_group

. program define run_stability_group
  1.     args grp
  2. 
.     * Skip se entrambe le stime del gruppo sono gia' su disco.
.     * $SFX e' indispensabile qui: senza, la variante 2 troverebbe i file del
.     * baseline e si dichiarerebbe completa senza stimare (vedi trappola (a)).
.     cap confirm file "$TAB\STAB_`grp'_WB$SFX.dta"
  3.     local rc_wb = _rc
  4.     cap confirm file "$TAB\STAB_`grp'_TREND$SFX.dta"
  5.     local rc_tr = _rc
  6.     if `rc_wb' == 0 & `rc_tr' == 0 {
  7.         di as text "  SKIP `grp' (entrambe le stime presenti)"
  8.         exit 0
  9.     }
 10. 
.     di as text _n "########## GRUPPO: `grp' ##########"
 11.     use ln_export WB_EP_Depth TREND_EP_Count hs6 country_code year fpd fdt
>  pt ///
>         using "$DTA", clear
 12. 
.     * HK/Macao: esclusi nella spec principale, tenuti nella variante `incl'
.     if "$VSAMPLE" == "excl" {
 13.         gen byte hkmo = inlist(country_code, 110, 121)
 14.         keep if !hkmo
 15.         drop hkmo
 16.     }
 17. 
.     * Filtro del gruppo, applicato subito per contenere la RAM
.     if "`grp'" == "prodHS4" {
 18.         merge m:1 hs6 using "$F_HS4", keep(master match) nogen
 19.         keep if keep_hs4 == 1
 20.         drop keep_hs4
 21.     }
 22.     if "`grp'" == "deepshallow" {
 23.         merge m:1 country_code using "$F_DS", keep(master match) nogen
 24.         keep if keep_ds == 1
 25.         drop keep_ds
 26.     }
 27.     if "`grp'" == "cem_v1" {
 28.         merge m:1 country_code using "$F_CEM", keep(master match) nogen
 29.         keep if keep_cem == 1
 30.         drop keep_cem
 31.     }
 32.     count
 33.     di as text "  righe dopo filtro: " r(N)
 34. 
.     * Classificazioni ricalcolate (come 24.R, 17.do, 18.do)
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 35.     qui count if _merge == 3
 36.     di as text "  [merge green] righe appaiate: " r(N)
 37.     drop _merge
 38.     replace env_good_new = 0 if missing(env_good_new)
 39.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 40.     qui count if _merge == 3
 41.     di as text "  [merge dirty] righe appaiate: " r(N)
 42.     drop _merge
 43.     replace dirty_p = 0 if missing(dirty_p)
 44.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 45.     qui count if _merge == 3
 46.     di as text "  [merge depth] righe appaiate: " r(N)
 47.     drop _merge
 48.     * DESTA: le celle TRATTATE senza copertura si eliminano, le altre vann
> o a 0
.     * (stessa regola di 52 blocco 7, 63 e 65)
.     if "$VDEPTH" == "desta" {
 49.         qui count
 50.         local n0 = r(N)
 51.         drop if missing($DEPTHCOL) & WB_EP_Depth > 0
 52.         qui count
 53.         di as text "  [desta] celle trattate senza copertura eliminate: " 
> `n0' - r(N)
 54.     }
 55.     replace $DEPTHCOL = 0 if missing($DEPTHCOL)
 56.     drop hs6
 57. 
.     su env_good_new, meanonly
 58.     di as text "  green: " 100*r(mean) "%"
 59.     su dirty_p, meanonly
 60.     di as text "  dirty: " 100*r(mean) "%"
 61. 
.     gen double td_green = $DEPTHCOL * env_good_new
 62.     gen double td_dirty = $DEPTHCOL * dirty_p
 63. 
.     foreach treat in WB TREND {
 64.         local out_file "$TAB\STAB_`grp'_`treat'$SFX.dta"
 65.         cap confirm file "`out_file'"
 66.         if _rc {
 67.             local xvar = cond("`treat'" == "WB", "WB_EP_Depth", "TREND_EP_
> Count")
 68.             cap drop ep_green ep_dirty
 69.             gen double ep_green = `xvar' * env_good_new
 70.             gen double ep_dirty = `xvar' * dirty_p
 71.             di as text "  [`grp' `treat'] reghdfe fpd+fdt+pt..."
 72.             cap noisily reghdfe ln_export ep_green ep_dirty td_green td_di
> rty, ///
>                 absorb(fpd fdt pt) vce(cluster country_code) compact
 73.             if !_rc {
 74.                 regsave using "`out_file'", tstat pval ci replace ///
>                     addlabel(spec, stability, groupname, `grp', treat, `treat
> ', ///
>                              sample, $VSAMPLE, depth, $VDEPTH, ///
>                              source, reghdfe_stata_58)
 75.                 di as text "  [OK] STAB_`grp'_`treat'$SFX.dta"
 76.             }
 77.             else di as error "  [FALLITO] STAB_`grp'_`treat'"
 78.         }
 79.         else di as text "  SKIP `grp'_`treat' (gia' presente)"
 80.     }
 81. end

