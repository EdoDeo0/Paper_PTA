. confirm file "$DTA"

. 
. *****************************************************************************
> ***
. * Programma: stima le 2 spec (WB, TREND) per una variante e scrive il CSV
. *   `1' sfx      suffisso di output ("_inclHKMO", "_desta", "_inclHKMO_desta"
> )
. *   `2' sample   excl | incl
. *   `3' depthvar TotalDepth_nonEnv | DESTA_depth_index
. *****************************************************************************
> ***
. capture program drop ppml_variant

. program define ppml_variant
  1.     args sfx sample depthvar
  2. 
.     local out "$TAB\ppml_extensive`sfx'.csv"
  3.     capture confirm file "`out'"
  4.     if !_rc {
  5.         di as text "[`sfx'] gia' presente, salto."
  6.         exit 0
  7.     }
  8. 
.     di as text _n "==========================================================
> ===="
  9.     di as text "  PPML variante '`sfx'' | campione=`sample' | profondita'=
> `depthvar'"
 10.     di as text "==========================================================
> ===="
 11. 
.     use "$DTA", clear
 12.     if "`sample'" == "excl" {
 13.         drop if hkmo == 1
 14.     }
 15.     * DESTA: le celle TRATTATE senza copertura si eliminano, le altre -> 0
.     * (stessa regola di 52 blocco 7, 28.R e 63)
.     if "`depthvar'" == "DESTA_depth_index" {
 16.         qui count
 17.         local n0 = r(N)
 18.         drop if missing(DESTA_depth_index) & WB_EP_Depth > 0
 19.         qui count
 20.         di as text "  [desta] celle trattate senza copertura eliminate: " 
> `n0' - r(N)
 21.         replace DESTA_depth_index = 0 if missing(DESTA_depth_index)
 22.     }
 23.     qui count
 24.     di as text "  celle in stima (pre-ppmlhdfe): " r(N)
 25. 
.     file open fh using "`out'", write replace text
 26.     file write fh "treat,term,coef,se,pval,nobs,nclust,r2_p" _n
 27.     file close fh
 28. 
.     foreach treat in WB TREND {
 29.         if "`treat'" == "WB"    local xv "WB_EP_Depth"
 30.         if "`treat'" == "TREND" local xv "TREND_EP_Count"
 31. 
.         cap drop ep_green ep_dirty td_green td_dirty
 32.         qui gen double ep_green = `xv' * env_good
 33.         qui gen double ep_dirty = `xv' * dirty_p
 34.         qui gen double td_green = `depthvar' * env_good
 35.         qui gen double td_dirty = `depthvar' * dirty_p
 36. 
.         di as text "  [`treat'] ppmlhdfe..."
 37.         cap ppmlhdfe agg_export ep_green ep_dirty td_green td_dirty, ///
>             absorb(pd dt pt) vce(cluster country_code)
 38.         if _rc {
 39.             di as error "  [`treat'] ppmlhdfe fallito (rc=" _rc ")"
 40.             continue
 41.         }
 42.         local NN = e(N)
 43.         local NC = e(N_clust)
 44.         local R2 = e(r2_p)
 45.         di as res "    ep_green=" %10.7f _b[ep_green] "  ep_dirty=" %10.7f
>  _b[ep_dirty] "  N=" `NN' "  N_clust=" `NC' "  r2_p=" %6.4f `R2'
 46. 
.         local i = 1
 47.         foreach v in ep_green ep_dirty td_green td_dirty {
 48.             if `i' == 1 local tn "`xv':env_good"
 49.             if `i' == 2 local tn "`xv':dirty_p"
 50.             if `i' == 3 local tn "env_good:`depthvar'"
 51.             if `i' == 4 local tn "dirty_p:`depthvar'"
 52.             local b  = _b[`v']
 53.             local se = _se[`v']
 54.             local p  = 2 * normal(-abs(`b'/`se'))
 55.             file open fh using "`out'", write append text
 56.             file write fh "`treat',`tn',`b',`se',`p',`NN',`NC',`R2'" _n
 57.             file close fh
 58.             local ++i
 59.         }
 60.     }
 61.     di as result "[`sfx'] scritto `out'"
 62. end

