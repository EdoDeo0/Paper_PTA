. *── 3. Loop sulle 4 strutture FE x 4 blocchi x 6 formule = 96 stime ─────────
> ───
. * struttura FE: absorb() da usare
. local fe_labels  fpd_year   fpt_pd   fpt_fpd   fpd_pt

. 
. local fe_n = 1

. foreach fe_label of local fe_labels {
  2.     * indicizzazione manuale (i local con spazi dentro non si accodano ben
> e a `word')
.     if `fe_n' == 1 local absorb_vars "fpd year"
  3.     if `fe_n' == 2 local absorb_vars "fpt pd"
  4.     if `fe_n' == 3 local absorb_vars "fpt fpd"
  5.     if `fe_n' == 4 local absorb_vars "fpd pt"
  6. 
.     di as text _n "========== FE: `absorb_vars' (`fe_label') =========="
  7. 
.     foreach treat in WB TREND {
  8.         local xvar    = cond("`treat'" == "WB", "WB_EP_Depth", "TREND_EP_C
> ount")
  9.         local xinter  = cond("`treat'" == "WB", "wb_x_env", "tr_x_env")
 10. 
.         foreach inter in NI Int {
 11.             foreach outcome in ln_export ln_export_qua ln_export_value {
 12.                 foreach ctrl in 0 1 {
 13. 
.                     local tag "`treat'_`inter'_`fe_label'_`outcome'_ctrl`ctrl
> '"
 14.                     local out_file "$TAB\OLS_`tag'.dta"
 15. 
.                     cap confirm file "`out_file'"
 16.                     if _rc {
 17.                         local ctrl_vars ""
 18.                         if `ctrl' == 1 local ctrl_vars "tariffs ln_hhi_bac
> i"
 19. 
.                         local rhs "`xvar'"
 20.                         if "`inter'" == "Int" local rhs "`xvar' env_good_n
> ew `xinter'"
 21. 
.                         di as text "  [`tag'] `outcome' ~ `rhs' `ctrl_vars' |
>  `absorb_vars'"
 22.                         cap noisily reghdfe `outcome' `rhs' `ctrl_vars', /
> //
>                             absorb(`absorb_vars') vce(cluster country_code) c
> ompact
 23.                         if !_rc {
 24.                             regsave using "`out_file'", tstat pval ci repl
> ace ///
>                                 addlabel(treat, `treat', inter, `inter', fe, 
> `fe_label', ///
>                                          outcome, `outcome', ctrl, `ctrl')
 25.                         }
 26.                         else di as error "  [FALLITO] `tag'"
 27.                     }
 28.                     else di as text "  SKIP `tag' (gia' presente)"
 29.                 }
 30.             }
 31.         }
 32.     }
 33.     local fe_n = `fe_n' + 1
 34. }

