. local outG "$TAB\r79c_pretrends$SFX.csv"

. capture confirm file "`outG'"

. if _rc {
.     load_variant
. 
.     * anno di entrata (definito su WB, come in 28.R); mai trattate -> 10000
.     qui gen int _ey = year if WB_EP_Depth > 0
.     bysort country_code: egen int entry_year = min(_ey)
.     drop _ey
.     replace entry_year = 10000 if missing(entry_year)
. 
.     qui gen double slope_g = 0
.     qui gen double slope_b = 0
.     qui levelsof country_code, local(ccs)
.     local nfit = 0
.     foreach cc of local ccs {
  2.         qui count if country_code == `cc' & year < entry_year
  3.         if r(N) == 0 continue
  4.         qui levelsof year if country_code == `cc' & year < entry_year, loc
> al(yy)
  5.         local nyy : word count `yy'
  6.         qui su env_good if country_code == `cc' & year < entry_year, meano
> nly
  7.         local sumg = r(sum)
  8.         if `nyy' < 2 | `sumg' == 0 continue
  9.         cap qui reg y c.year c.env_good c.dirty_p c.year#c.env_good c.year
> #c.dirty_p ///
>             [aw=n] if country_code == `cc' & year < entry_year
 10.         if _rc continue
 11.         local sg = _b[c.year#c.env_good]
 12.         local sb = _b[c.year#c.dirty_p]
 13.         if missing(`sg') local sg = 0
 14.         if missing(`sb') local sb = 0
 15.         qui replace slope_g = `sg' if country_code == `cc'
 16.         qui replace slope_b = `sb' if country_code == `cc'
 17.         local ++nfit
 18.     }
.     di as text "  [G] slope pre-periodo stimate per `nfit' destinazioni"
. 
.     qui gen double y_adj = y - slope_g * (year - 2000) * env_good ///
>                              - slope_b * (year - 2000) * dirty_p
.     qui gen double td_green = $DEPTHVAR * env_good
.     qui gen double td_dirty = $DEPTHVAR * dirty_p
. 
.     file open fh using "`outG'", write replace text
.     file write fh "treat,term,coef,se_asy,p_asy,p_wcb,conf_low,conf_high,nobs
> ,B" _n
.     file close fh
. 
.     foreach treat in WB TREND {
  2.         if "`treat'" == "WB"  local xv "WB_EP_Depth"
  3.         if "`treat'" == "TREND" local xv "TREND_EP_Count"
  4.         cap drop ep_green ep_dirty
  5.         qui gen double ep_green = `xv' * env_good
  6.         qui gen double ep_dirty = `xv' * dirty_p
  7.         * reghdfe diretto (per verifica FWL)
.         qui reghdfe y_adj ep_green ep_dirty td_green td_dirty [aw=n], ///
>             absorb(pd dt pt) vce(cluster country_code)
  8.         local b_direct_ep_green = _b[ep_green]
  9.         local b_direct_ep_dirty = _b[ep_dirty]
 10.         foreach v in y_adj ep_green ep_dirty td_green td_dirty {
 11.             cap drop `v'_dm
 12.             qui reghdfe `v' [aw=n], absorb(pd dt pt) residuals(`v'_dm) tol
> (1e-8)
 13.         }
 14.         qui reg y_adj_dm ep_green_dm ep_dirty_dm td_green_dm td_dirty_dm [
> aw=n], ///
>             cluster(country_code) nocons
 15.         local NN  = e(N)
 16.         local NCL = e(N_clust)
 17.         * Verifica manuale: i coefficienti FWL devono coincidere con il re
> ghdfe diretto
.         assert abs(_b[ep_green_dm] - `b_direct_ep_green') < 1e-6
 18.         assert abs(_b[ep_dirty_dm] - `b_direct_ep_dirty') < 1e-6
 19.         foreach p in ep_green ep_dirty {
 20.             local b  = _b[`p'_dm]
 21.             local se = _se[`p'_dm]
 22.             local pa = 2 * ttail(`NCL'-1, abs(`b'/`se'))
 23.             set seed 42
 24.             cap boottest `p'_dm, reps($BREPS) cluster(country_code) nograp
> h
 25.             if _rc {
 26.                 local pb = .
 27.                 local lo = .
 28.                 local hi = .
 29.             }
 30.             else {
 31.                 local pb = r(p)
 32.                 cap local lo = r(CI)[1,1]
 33.                 cap local hi = r(CI)[1,2]
 34.             }
 35.             di as res "  [G `treat'] `p': coef=" %10.7f `b' "  p_wcb=" %6.
> 4f `pb'
 36.             wrow "`outG'" "`treat',`p',`b',`se',`pa',`pb',`lo',`hi',`NN',$
> BREPS"
 37.         }
 38.     }
.     di as result "[G] scritto `outG'"
. }

. else di as text "[G] gia' presente, salto."
[G] gia' presente, salto.

. 
. di as result _n "=== 63 FATTO per variante '$SFX' ==="

=== 63 FATTO per variante '_desta' ===

. 
. cap log close _all
