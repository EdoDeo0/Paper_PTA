. *****************************************************************************
> ***
. * BLOCCO A - baseline collassato  ->  tripledd_collapsed{sfx}.csv
. *   schema R: treat,term,coef,se,pval,nobs
. *****************************************************************************
> ***
. local outA "$TAB\tripledd_collapsed$SFX.csv"

. capture confirm file "`outA'"

. if _rc {
.     load_variant
.     file open fh using "`outA'", write replace text
.     file write fh "treat,term,coef,se,pval,nobs" _n
.     file close fh
. 
.     foreach treat in WB TREND {
  2.         if "`treat'" == "WB"  local xv "WB_EP_Depth"
  3.         if "`treat'" == "TREND" local xv "TREND_EP_Count"
  4.         cap drop ep_green ep_dirty td_green td_dirty
  5.         qui gen double ep_green = `xv' * env_good
  6.         qui gen double ep_dirty = `xv' * dirty_p
  7.         qui gen double td_green = $DEPTHVAR * env_good
  8.         qui gen double td_dirty = $DEPTHVAR * dirty_p
  9.         qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], ///
>             absorb(pd dt pt) vce(cluster country_code)
 10.         local NN = e(N)
 11.         di as res "  [A `treat'] ep_green=" %10.7f _b[ep_green] "  ep_dirt
> y=" %10.7f _b[ep_dirty] "  N=" `NN'
 12.         * nomi dei termini identici a quelli usati da R (fixest)
.         local t1 "`xv':env_good"
 13.         local t2 "`xv':dirty_p"
 14.         local t3 "env_good:$DEPTHVAR"
 15.         local t4 "dirty_p:$DEPTHVAR"
 16.         local i = 1
 17.         foreach v in ep_green ep_dirty td_green td_dirty {
 18.             local tn "`t`i''"
 19.             local b  = _b[`v']
 20.             local s  = _se[`v']
 21.             local p  = 2 * ttail(e(df_r), abs(`b'/`s'))
 22.             wrow "`outA'" "`treat',`tn',`b',`s',`p',`NN'"
 23.             local ++i
 24.         }
 25.     }
.     di as result "[A] scritto `outA'"
. }

. else di as text "[A] gia' presente, salto."
[A] gia' presente, salto.

