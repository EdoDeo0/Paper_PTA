. capture program drop load_variant

. program define load_variant
  1.     use "$VDTA", clear
  2.     qui su WB_EP_Depth, meanonly
  3.     if r(max) != 17 {
  4.         di as error "WB_EP_Depth max=" r(max) " (atteso 17). Dataset stant
> io."
  5.         exit 1
  6.     }
  7.     * DESTA: le celle TRATTATE senza copertura DESTA si eliminano (Timor E
> st e
.     * simili), le non trattate prendono 0. Identico a 52 blocco 7 e a 28.R.
.     if "$VDEPTH" == "desta" {
  8.         qui count
  9.         local n0 = r(N)
 10.         drop if missing(DESTA_depth_index) & WB_EP_Depth > 0
 11.         qui count
 12.         di as text "[desta] celle trattate senza copertura eliminate: " `n
> 0' - r(N)
 13.         replace DESTA_depth_index = 0 if missing(DESTA_depth_index)
 14.     }
 15.     qui count
 16.     di as text "[dati] celle in memoria: " r(N)
 17. end

