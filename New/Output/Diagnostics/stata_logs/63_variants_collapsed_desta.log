.     qui count
.     local nobs_pre = r(N)
.     file open fh using "`outB'", write replace text
.     file write fh "treat,term,coef,p_wcb,conf_low,conf_high,B,nobs_pre,nclust
> ,fe,nobs_post" _n
.     file close fh
. 
.     foreach treat in WB TREND {
  2.         if "`treat'" == "WB"  local xv "WB_EP_Depth"
  3.         if "`treat'" == "TREND" local xv "TREND_EP_Count"
  4.         cap drop ep_green ep_dirty td_green td_dirty
  5.         qui gen double ep_green = `xv' * env_good
  6.         qui gen double ep_dirty = `xv' * dirty_p
  7.         qui gen double td_green = $DEPTHVAR * env_good
  8.         qui gen double td_dirty = $DEPTHVAR * dirty_p
  9.         * reghdfe diretto (per verifica FWL)
.         qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], ///
>             absorb(pd dt pt) vce(cluster country_code)
 10.         local b_direct_ep_green = _b[ep_green]
 11.         local b_direct_ep_dirty = _b[ep_dirty]
 12.         * Frisch-Waugh: demean con [aw=n] su pd dt pt (come 52 S3 e come R
> )
.         foreach v in y ep_green ep_dirty td_green td_dirty {
 13.             cap drop `v'_dm
 14.             qui reghdfe `v' [aw=n], absorb(pd dt pt) residuals(`v'_dm) tol
> (1e-8)
 15.         }
 16.         qui reg y_dm ep_green_dm ep_dirty_dm td_green_dm td_dirty_dm [aw=n
> ], ///
>             cluster(country_code) nocons
 17.         local nobs_post = e(N)
 18.         local nclust    = e(N_clust)
 19.         * Verifica manuale: i coefficienti FWL devono coincidere con il re
> ghdfe diretto
.         assert abs(_b[ep_green_dm] - `b_direct_ep_green') < 1e-6
 20.         assert abs(_b[ep_dirty_dm] - `b_direct_ep_dirty') < 1e-6
 21.         foreach p in ep_green ep_dirty {
 22.             local b = _b[`p'_dm]
 23.             set seed 42
 24.             cap boottest `p'_dm, reps($BREPS) cluster(country_code) nograp
> h
 25.             if _rc {
 26.                 local pb = .
 27.                 local lo = .
 28.                 local hi = .
 29.             }
 30.             else {
 31.                 local pb = r(p)
 32.                 cap local lo = r(CI)[1,1]
 33.                 cap local hi = r(CI)[1,2]
 34.             }
 35.             di as res "  [B `treat'] `p': coef=" %10.7f `b' "  p_wcb=" %6.
> 4f `pb'
 36.             wrow "`outB'" "`treat',`p',`b',`pb',`lo',`hi',$BREPS,`nobs_pre
> ',`nclust',pd+dt+pt,`nobs_post'"
 37.         }
 38.     }
.     di as result "[B] scritto `outB'"
. }

. else di as text "[B] gia' presente, salto."
