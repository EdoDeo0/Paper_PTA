. ************************************************************
. * Programma: stima CEM per una outcome
. ************************************************************
. capture program drop cem_one_outcome

. program define cem_one_outcome
  1.     args raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  CEM: `outcome_label' ($PTA_DEPTH)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     * --- Carica dati ---
.     if "`raw_var'" == "ln_export" {
  8.         use ln_export WB_EP_Depth TREND_EP_Count hs6 country_code year fpd
>  fdt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
  9.         rename ln_export ln_y
 10.     }
 11.     else if "`raw_var'" == "exp_qua" {
 12.         use exp_qua WB_EP_Depth TREND_EP_Count hs6 country_code year fpd f
> dt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 13.         gen double ln_y = ln(exp_qua)
 14.         drop exp_qua
 15.         drop if missing(ln_y)
 16.     }
 17.     else if "`raw_var'" == "uv_exp" {
 18.         use uv_exp WB_EP_Depth TREND_EP_Count hs6 country_code year fpd fd
> t pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 19.         gen double ln_y = ln(uv_exp)
 20.         drop uv_exp
 21.         drop if missing(ln_y)
 22.     }
 23. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 24.     keep if $HKMOEXPR
 25.     drop hkmo
 26. 
.     * --- Filtro CEM ---
.     merge m:1 country_code using "$F_CEM", keep(master match) nogen
 27.     keep if keep_cem == 1
 28.     drop keep_cem
 29.     count
 30.     di "  Righe dopo filtro CEM: " r(N)
 31. 
.     * --- Merge classificazioni ---
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 32.     drop _merge
 33.     replace env_good_new = 0 if missing(env_good_new)
 34.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 35.     drop _merge
 36.     replace dirty_p = 0 if missing(dirty_p)
 37.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 38.     drop _merge
 39.     if $DROP_UNMEASURED {
 40.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 41.     }
 42.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 43. 
.     gen double wb_green = WB_EP_Depth    * env_good_new
 44.     gen double wb_dirty = WB_EP_Depth    * dirty_p
 45.     gen double tr_green = TREND_EP_Count * env_good_new
 46.     gen double tr_dirty = TREND_EP_Count * dirty_p
 47.     gen double td_green = $DEPTHVAR * env_good_new
 48.     gen double td_dirty = $DEPTHVAR * dirty_p
 49.     drop WB_EP_Depth TREND_EP_Count env_good_new dirty_p $DEPTHVAR hs6
 50. 
.     count
 51.     local N_raw = r(N)
 52.     di "  Righe finali: `N_raw'"
 53. 
.     * --- WB: reghdfe asintotico ---
.     di as txt "  [WB] reghdfe fpd+fdt+pt..."
 54.     reghdfe ln_y wb_green wb_dirty td_green td_dirty, ///
>         absorb(fpd fdt pt) vce(cluster country_code) compact
 55.     local nobs   = e(N)
 56.     local nclust = e(N_clust)
 57.     local r2a    = e(r2_a)
 58. 
.     local b_wg = _b[wb_green]
 59.     local b_wd = _b[wb_dirty]
 60.     local se_wg = _se[wb_green]
 61.     local se_wd = _se[wb_dirty]
 62.     local p_wg = 2*ttail(`nclust'-1, abs(`b_wg'/`se_wg'))
 63.     local p_wd = 2*ttail(`nclust'-1, abs(`b_wd'/`se_wd'))
 64. 
.     di as txt "  [WB] demeaning per boottest..."
 65.     local dmvars ln_y wb_green wb_dirty td_green td_dirty
 66.     foreach v of local dmvars {
 67.         cap drop `v'_dm
 68.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
 69.     }
 70. 
.     qui reg ln_y_dm wb_green_dm wb_dirty_dm td_green_dm td_dirty_dm, cluster(
> country_code) nocons
 71. 
.     di as txt "    boottest WB_green..."
 72.     set seed 42
 73.     boottest wb_green_dm, boottype(wild) reps(9999) noci
 74.     local pwcb_wg = r(p)
 75.     set seed 42
 76.     boottest wb_green_dm, boottype(wild) reps(9999)
 77.     local ci_wg_lo = r(CI)[1,1]
 78.     local ci_wg_hi = r(CI)[1,2]
 79. 
.     di as txt "    boottest WB_dirty..."
 80.     set seed 42
 81.     boottest wb_dirty_dm, boottype(wild) reps(9999) noci
 82.     local pwcb_wd = r(p)
 83.     set seed 42
 84.     boottest wb_dirty_dm, boottype(wild) reps(9999)
 85.     local ci_wd_lo = r(CI)[1,1]
 86.     local ci_wd_hi = r(CI)[1,2]
 87. 
.     write_row "WB_green" wb_green `b_wg' `se_wg' `p_wg' `pwcb_wg' `ci_wg_lo' 
> `ci_wg_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
 88.     write_row "WB_dirty" wb_dirty `b_wd' `se_wd' `p_wd' `pwcb_wd' `ci_wd_l
> o' `ci_wd_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
 89. 
.     * --- TREND: reghdfe asintotico ---
.     di as txt "  [TREND] reghdfe fpd+fdt+pt..."
 90.     reghdfe ln_y tr_green tr_dirty td_green td_dirty, ///
>         absorb(fpd fdt pt) vce(cluster country_code) compact
 91.     local nobs   = e(N)
 92.     local nclust = e(N_clust)
 93.     local r2a    = e(r2_a)
 94. 
.     local b_tg = _b[tr_green]
 95.     local b_td = _b[tr_dirty]
 96.     local se_tg = _se[tr_green]
 97.     local se_td = _se[tr_dirty]
 98.     local p_tg = 2*ttail(`nclust'-1, abs(`b_tg'/`se_tg'))
 99.     local p_td = 2*ttail(`nclust'-1, abs(`b_td'/`se_td'))
100. 
.     di as txt "  [TREND] demeaning per boottest..."
101.     foreach v in ln_y tr_green tr_dirty td_green td_dirty {
102.         cap drop `v'_dm
103.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
104.     }
105. 
.     qui reg ln_y_dm tr_green_dm tr_dirty_dm td_green_dm td_dirty_dm, cluster(
> country_code) nocons
106. 
.     di as txt "    boottest TREND_green..."
107.     set seed 42
108.     boottest tr_green_dm, boottype(wild) reps(9999) noci
109.     local pwcb_tg = r(p)
110.     set seed 42
111.     boottest tr_green_dm, boottype(wild) reps(9999)
112.     local ci_tg_lo = r(CI)[1,1]
113.     local ci_tg_hi = r(CI)[1,2]
114. 
.     di as txt "    boottest TREND_dirty..."
115.     set seed 42
116.     boottest tr_dirty_dm, boottype(wild) reps(9999) noci
117.     local pwcb_td = r(p)
118.     set seed 42
119.     boottest tr_dirty_dm, boottype(wild) reps(9999)
120.     local ci_td_lo = r(CI)[1,1]
121.     local ci_td_hi = r(CI)[1,2]
122. 
.     write_row "TREND_green" tr_green `b_tg' `se_tg' `p_tg' `pwcb_tg' `ci_tg_l
> o' `ci_tg_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
123.     write_row "TREND_dirty" tr_dirty `b_td' `se_td' `p_td' `pwcb_td' `ci_t
> d_lo' `ci_td_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
124. 
.     timer off 1
125.     qui timer list 1
126.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
127. end

. 
. ************************************************************
. * Esecuzione
. ************************************************************
. di as result _n "*** 48j — CEM: val + quantity + unit value ***"

