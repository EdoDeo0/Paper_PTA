    format

. restore

. 
. * Lista paesi unici ordinata
. use `tprofile', clear

. keep country_code

. duplicates drop country_code, force

Duplicates in terms of country_code

(3,380 observations deleted)

. sort country_code

. local nc = _N

. di as text "Paesi unici: `nc'"
Paesi unici: 236

. tempfile clist

. save `clist'
file C:\Users\edodr\AppData\Local\Temp\ST_aeb0_000003.tmp saved as .dta
    format

. 
. * Dataset base senza variabili trattamento (mantiene country_code, year)
. use "$DTA", clear

. drop WB_EP_Depth TREND_EP_Count TotalDepth_nonEnv

. sort country_code year

. tempfile base

. save `base'
file C:\Users\edodr\AppData\Local\Temp\ST_aeb0_000004.tmp saved as .dta
    format

. 
. * b_obs: stima baseline con cluster
. di as text "=== b_obs ==="
=== b_obs ===

. use "$DTA", clear

. gen double ep_green = WB_EP_Depth * env_good

. gen double ep_dirty = WB_EP_Depth * dirty_p

. gen double td_green = TotalDepth_nonEnv * env_good

. gen double td_dirty = TotalDepth_nonEnv * dirty_p

. qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], absorb(pd dt pt) vc
> e(cluster country_code) compact

. local b_obs_wb  = _b[ep_green]

. local se_obs_wb = _se[ep_green]

. local p_obs_wb  = 2*ttail(e(df_r), abs(`b_obs_wb'/`se_obs_wb'))

. di as text "WB b_obs=" `b_obs_wb' " p_asy=" `p_obs_wb'
WB b_obs=-.0045685 p_asy=.51208987

. drop ep_green ep_dirty td_green td_dirty

. 
. gen double ep_green = TREND_EP_Count * env_good

. gen double ep_dirty = TREND_EP_Count * dirty_p

. gen double td_green = TotalDepth_nonEnv * env_good

. gen double td_dirty = TotalDepth_nonEnv * dirty_p

. qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], absorb(pd dt pt) vc
> e(cluster country_code) compact

. local b_obs_tr  = _b[ep_green]

. local se_obs_tr = _se[ep_green]

. local p_obs_tr  = 2*ttail(e(df_r), abs(`b_obs_tr'/`se_obs_tr'))

. di as text "TREND b_obs=" `b_obs_tr' " p_asy=" `p_obs_tr'
TREND b_obs=.00181154 p_asy=.32032086

. 
. * Gestione file draws (resume-safe)
. local start_rep = 1

. local skip_loop = 0

. 
. cap confirm file "$DRAWS"

. if !_rc {
.     cap import delimited "$DRAWS", clear varnames(1) case(preserve)
.     if !_rc {
.         qui count
.         local ndone = r(N)
.     }
.     else {
.         local ndone = 0
.     }
.     if `ndone' > 0 {
.         di as text "Draws presenti: `ndone' -- riprendo da rep " `ndone'+1
.         local start_rep = `ndone' + 1
.         if `start_rep' > 1000 {
.             local skip_loop = 1
.         }
.     }
.     else {
.         file open fh using "$DRAWS", write replace text
.         file write fh "rep,b_wb_green,b_wb_dirty,b_tr_green,b_tr_dirty" _n
.         file close fh
.     }
. }

. else {
.     file open fh using "$DRAWS", write replace text
(file
    C:\Work\projects\Paper_PTA\New\Output\TripleDiff\Tables_Stata\permutation
    > _draws.csv not found)
.     file write fh "rep,b_wb_green,b_wb_dirty,b_tr_green,b_tr_dirty" _n
.     file close fh
. }

. 
. if `start_rep' == 1 set seed 42

. 
. * Loop permutazione (country_code-based, nessun orig_i)
. if !`skip_loop' {
. 
. forvalues b = `start_rep'/1000 {
  2.     if mod(`b', 50) == 0 di as text "Rep `b'/1000 -- " c(current_time)
  3. 
.     use `clist', clear
  4.     gen double u = runiform()
  5.     sort u
  6.     rename country_code donor_cc
  7.     gen int recv_rank = _n
  8.     tempfile donors
  9.     save `donors'
 10. 
.     use `clist', clear
 11.     gen int recv_rank = _n
 12.     merge 1:1 recv_rank using `donors', keepusing(donor_cc) nogen
 13.     keep country_code donor_cc
 14.     tempfile bijection
 15.     save `bijection'
 16. 
.     use `tprofile', clear
 17.     rename country_code donor_cc
 18.     merge m:1 donor_cc using `bijection', keepusing(country_code) nogen
 19.     keep country_code year WB_EP_Depth TREND_EP_Count TotalDepth_nonEnv
 20.     sort country_code year
 21.     tempfile perm_treat
 22.     save `perm_treat'
 23. 
.     use `base', clear
 24.     merge m:1 country_code year using `perm_treat', nogen
 25. 
.     gen double ep_green = WB_EP_Depth * env_good
 26.     gen double ep_dirty = WB_EP_Depth * dirty_p
 27.     gen double td_green = TotalDepth_nonEnv * env_good
 28.     gen double td_dirty = TotalDepth_nonEnv * dirty_p
 29.     qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], absorb(pd dt
>  pt) compact
 30.     local b_wb_g = _b[ep_green]
 31.     local b_wb_d = _b[ep_dirty]
 32.     drop ep_green ep_dirty td_green td_dirty
 33. 
.     gen double ep_green = TREND_EP_Count * env_good
 34.     gen double ep_dirty = TREND_EP_Count * dirty_p
 35.     gen double td_green = TotalDepth_nonEnv * env_good
 36.     gen double td_dirty = TotalDepth_nonEnv * dirty_p
 37.     qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], absorb(pd dt
>  pt) compact
 38.     local b_tr_g = _b[ep_green]
 39.     local b_tr_d = _b[ep_dirty]
 40.     drop ep_green ep_dirty td_green td_dirty WB_EP_Depth TREND_EP_Count To
> talDepth_nonEnv
 41. 
.     file open fh using "$DRAWS", write append text
 42.     file write fh "`b',`b_wb_g',`b_wb_d',`b_tr_g',`b_tr_d'" _n
 43.     file close fh
 44. }
