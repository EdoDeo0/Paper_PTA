. ************************************************************
. * Programma: stima C-prod-HS4 per una outcome
. ************************************************************
. capture program drop cprodhs4_one_outcome

. program define cprodhs4_one_outcome
  1.     args raw_var outcome_label
  2. 
.     di as result _n "========================================================
> ===="
  3.     di as result "  C-prod-HS4: `outcome_label' ($PTA_DEPTH)"
  4.     di as result "========================================================
> ===="
  5. 
.     timer clear 1
  6.     timer on 1
  7. 
.     * --- Carica dati ---
.     if "`raw_var'" == "exp_qua" {
  8.         use exp_qua WB_EP_Depth TREND_EP_Count hs6 country_code year fpd f
> dt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
  9.         gen double ln_y = ln(exp_qua)
 10.         drop exp_qua
 11.         drop if missing(ln_y)
 12.     }
 13.     else if "`raw_var'" == "uv_exp" {
 14.         use uv_exp WB_EP_Depth TREND_EP_Count hs6 country_code year fpd fd
> t pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 15.         gen double ln_y = ln(uv_exp)
 16.         drop uv_exp
 17.         drop if missing(ln_y)
 18.     }
 19. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 20.     keep if $HKMOEXPR
 21.     drop hkmo
 22. 
.     * --- Filtro C-prod-HS4 ---
.     merge m:1 hs6 using "$F_HS4", keep(master match) nogen
 23.     keep if keep_hs4 == 1
 24.     drop keep_hs4
 25.     count
 26.     di "  Righe dopo filtro prodHS4: " r(N)
 27. 
.     * --- Merge classificazioni ---
.     merge m:1 hs6 using "$F_GREEN", keep(master match)
 28.     drop _merge
 29.     replace env_good_new = 0 if missing(env_good_new)
 30.     merge m:1 hs6 using "$F_DIRTY", keep(master match)
 31.     drop _merge
 32.     replace dirty_p = 0 if missing(dirty_p)
 33.     merge m:1 country_code year using "$F_DEPTH", keep(master match)
 34.     drop _merge
 35.     if $DROP_UNMEASURED {
 36.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 37.     }
 38.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 39. 
.     gen double wb_green = WB_EP_Depth    * env_good_new
 40.     gen double wb_dirty = WB_EP_Depth    * dirty_p
 41.     gen double tr_green = TREND_EP_Count * env_good_new
 42.     gen double tr_dirty = TREND_EP_Count * dirty_p
 43.     gen double td_green = $DEPTHVAR * env_good_new
 44.     gen double td_dirty = $DEPTHVAR * dirty_p
 45.     drop WB_EP_Depth TREND_EP_Count env_good_new dirty_p $DEPTHVAR hs6
 46. 
.     count
 47.     local N_raw = r(N)
 48.     di "  Righe finali: `N_raw'"
 49. 
.     * --- WB: reghdfe asintotico ---
.     di as txt "  [WB] reghdfe fpd+fdt+pt..."
 50.     reghdfe ln_y wb_green wb_dirty td_green td_dirty, ///
>         absorb(fpd fdt pt) vce(cluster country_code) compact
 51.     local nobs   = e(N)
 52.     local nclust = e(N_clust)
 53.     local r2a    = e(r2_a)
 54. 
.     local b_wg = _b[wb_green]
 55.     local b_wd = _b[wb_dirty]
 56.     local se_wg = _se[wb_green]
 57.     local se_wd = _se[wb_dirty]
 58.     local p_wg = 2*ttail(`nclust'-1, abs(`b_wg'/`se_wg'))
 59.     local p_wd = 2*ttail(`nclust'-1, abs(`b_wd'/`se_wd'))
 60. 
.     * FWL demeaning
.     di as txt "  [WB] demeaning per boottest..."
 61.     local dmvars ln_y wb_green wb_dirty td_green td_dirty
 62.     foreach v of local dmvars {
 63.         cap drop `v'_dm
 64.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
 65.     }
 66. 
.     qui reg ln_y_dm wb_green_dm wb_dirty_dm td_green_dm td_dirty_dm, cluster(
> country_code) nocons
 67. 
.     di as txt "    boottest WB_green..."
 68.     set seed 42
 69.     boottest wb_green_dm, boottype(wild) reps(9999) noci
 70.     local pwcb_wg = r(p)
 71.     set seed 42
 72.     boottest wb_green_dm, boottype(wild) reps(9999)
 73.     local ci_wg_lo = r(CI)[1,1]
 74.     local ci_wg_hi = r(CI)[1,2]
 75. 
.     di as txt "    boottest WB_dirty..."
 76.     set seed 42
 77.     boottest wb_dirty_dm, boottype(wild) reps(9999) noci
 78.     local pwcb_wd = r(p)
 79.     set seed 42
 80.     boottest wb_dirty_dm, boottype(wild) reps(9999)
 81.     local ci_wd_lo = r(CI)[1,1]
 82.     local ci_wd_hi = r(CI)[1,2]
 83. 
.     write_row "WB_green" wb_green `b_wg' `se_wg' `p_wg' `pwcb_wg' `ci_wg_lo' 
> `ci_wg_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
 84.     write_row "WB_dirty" wb_dirty `b_wd' `se_wd' `p_wd' `pwcb_wd' `ci_wd_l
> o' `ci_wd_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
 85. 
.     * --- TREND: reghdfe asintotico ---
.     di as txt "  [TREND] reghdfe fpd+fdt+pt..."
 86.     reghdfe ln_y tr_green tr_dirty td_green td_dirty, ///
>         absorb(fpd fdt pt) vce(cluster country_code) compact
 87.     local nobs   = e(N)
 88.     local nclust = e(N_clust)
 89.     local r2a    = e(r2_a)
 90. 
.     local b_tg = _b[tr_green]
 91.     local b_td = _b[tr_dirty]
 92.     local se_tg = _se[tr_green]
 93.     local se_td = _se[tr_dirty]
 94.     local p_tg = 2*ttail(`nclust'-1, abs(`b_tg'/`se_tg'))
 95.     local p_td = 2*ttail(`nclust'-1, abs(`b_td'/`se_td'))
 96. 
.     di as txt "  [TREND] demeaning per boottest..."
 97.     foreach v in ln_y tr_green tr_dirty td_green td_dirty {
 98.         cap drop `v'_dm
 99.         qui reghdfe `v', absorb(fpd fdt pt) residuals(`v'_dm) tol(1e-8)
100.     }
101. 
.     qui reg ln_y_dm tr_green_dm tr_dirty_dm td_green_dm td_dirty_dm, cluster(
> country_code) nocons
102. 
.     di as txt "    boottest TREND_green..."
103.     set seed 42
104.     boottest tr_green_dm, boottype(wild) reps(9999) noci
105.     local pwcb_tg = r(p)
106.     set seed 42
107.     boottest tr_green_dm, boottype(wild) reps(9999)
108.     local ci_tg_lo = r(CI)[1,1]
109.     local ci_tg_hi = r(CI)[1,2]
110. 
.     di as txt "    boottest TREND_dirty..."
111.     set seed 42
112.     boottest tr_dirty_dm, boottype(wild) reps(9999) noci
113.     local pwcb_td = r(p)
114.     set seed 42
115.     boottest tr_dirty_dm, boottype(wild) reps(9999)
116.     local ci_td_lo = r(CI)[1,1]
117.     local ci_td_hi = r(CI)[1,2]
118. 
.     write_row "TREND_green" tr_green `b_tg' `se_tg' `p_tg' `pwcb_tg' `ci_tg_l
> o' `ci_tg_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
119.     write_row "TREND_dirty" tr_dirty `b_td' `se_td' `p_td' `pwcb_td' `ci_t
> d_lo' `ci_td_hi' `nobs' `nclust' 9999 `outcome_label' `r2a'
120. 
.     timer off 1
121.     qui timer list 1
122.     di as result "  -> `outcome_label' completato in " r(t1)/60 " minuti"
123. end

. 
. ************************************************************
. * Esecuzione
. ************************************************************
. di as result _n "*** 48h — C-prod-HS4: quantity + unit value ***"

*** 48h — C-prod-HS4: quantity + unit value ***

. di as result "*** Depth: $PTA_DEPTH | Sample: $PTA_SAMPLE ***"
*** Depth: desta | Sample: excl ***

