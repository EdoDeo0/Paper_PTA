. *════════════════════════════════════════════════════════════════════════════
> ══
. * Programma: stima ladder triple-diff per una outcome gia' in memoria
. *════════════════════════════════════════════════════════════════════════════
> ══
. capture program drop run_ladder_tripledd

. program define run_ladder_tripledd
  1.     args outcome_var outcome_lbl
  2. 
.     local fe_labels  fpd_year   fpt_pd   fpt_fpd   fpd_pt
  3.     local fe_n = 1
  4.     foreach fe_label of local fe_labels {
  5.         if `fe_n' == 1 local absorb_vars "fpd year"
  6.         if `fe_n' == 2 local absorb_vars "fpt pd"
  7.         if `fe_n' == 3 local absorb_vars "fpt fpd"
  8.         if `fe_n' == 4 local absorb_vars "fpd pt"
  9. 
.         di as text _n "=== [`outcome_lbl'] FE: `absorb_vars' (`fe_label') ===
> "
 10. 
.         foreach treat in WB TREND {
 11.             local ep_green = cond("`treat'" == "WB", "wb_green", "tr_green
> ")
 12.             local ep_dirty = cond("`treat'" == "WB", "wb_dirty", "tr_dirty
> ")
 13. 
.             foreach ctrl in 0 1 {
 14.                 local tag "`treat'_`fe_label'_`outcome_lbl'_ctrl`ctrl'"
 15.                 local out_file "$TAB/OLS_19d_`tag'$OUTSFX.dta"
 16. 
.                 cap confirm file "`out_file'"
 17.                 if _rc {
 18.                     local ctrl_vars ""
 19.                     if `ctrl' == 1 local ctrl_vars "tariffs ln_hhi_baci"
 20. 
.                     local rhs "`ep_green' `ep_dirty' td_green td_dirty"
 21. 
.                     di as text "  [`tag'] `outcome_var' ~ `rhs' `ctrl_vars' |
>  `absorb_vars'"
 22.                     cap noisily reghdfe `outcome_var' `rhs' `ctrl_vars', /
> //
>                         absorb(`absorb_vars') vce(cluster country_code) compa
> ct
 23.                     if !_rc {
 24.                         local ncl = e(N_clust)
 25.                         regsave using "`out_file'", tstat pval ci replace 
> ///
>                             addlabel(treat, `treat', ///
>                                      fe, `fe_label', outcome, `outcome_lbl', 
> ///
>                                      ctrl, `ctrl', nclust, `ncl')
 26.                         di "[OK] `tag' — N=" e(N) " clusters=" `ncl'
 27.                     }
 28.                     else di as error "  [FALLITO] `tag'"
 29.                 }
 30.                 else di as text "  SKIP `tag' (gia' presente)"
 31.             }
 32.         }
 33.         local fe_n = `fe_n' + 1
 34.     }
 35. end

. 
