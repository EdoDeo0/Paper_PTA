. *════════════════════════════════════════════════════════════════════════════
> ══
. * Programma: stima ladder per una outcome gia' in memoria
. *════════════════════════════════════════════════════════════════════════════
> ══
. capture program drop run_ladder_pass

. program define run_ladder_pass
  1.     args outcome_var outcome_lbl
  2. 
.     local fe_labels  fpd_year   fpt_pd   fpt_fpd   fpd_pt
  3.     local fe_n = 1
  4.     foreach fe_label of local fe_labels {
  5.         if `fe_n' == 1 local absorb_vars "fpd year"
  6.         if `fe_n' == 2 local absorb_vars "fpt pd"
  7.         if `fe_n' == 3 local absorb_vars "fpt fpd"
  8.         if `fe_n' == 4 local absorb_vars "fpd pt"
  9. 
.         di as text _n "=== [`outcome_lbl'] FE: `absorb_vars' (`fe_label') ===
> "
 10. 
.         foreach treat in WB TREND {
 11.             local xvar   = cond("`treat'" == "WB", "WB_EP_Depth", "TREND_E
> P_Count")
 12.             local xinter = cond("`treat'" == "WB", "wb_x_env",    "tr_x_en
> v")
 13. 
.             foreach inter in NI Int {
 14.                 foreach ctrl in 0 1 {
 15.                     local tag "`treat'_`inter'_`fe_label'_`outcome_lbl'_ct
> rl`ctrl'"
 16.                     local out_file "$TAB/OLS_19c_`tag'$OUTSFX.dta"
 17. 
.                     cap confirm file "`out_file'"
 18.                     if _rc {
 19.                         local ctrl_vars ""
 20.                         if `ctrl' == 1 local ctrl_vars "tariffs ln_hhi_bac
> i"
 21. 
.                         local rhs "`xvar'"
 22.                         if "`inter'" == "Int" local rhs "`xvar' env_good_n
> ew `xinter'"
 23. 
.                         di as text "  [`tag'] `outcome_var' ~ `rhs' `ctrl_var
> s' | `absorb_vars'"
 24.                         cap noisily reghdfe `outcome_var' `rhs' `ctrl_vars
> ', ///
>                             absorb(`absorb_vars') vce(cluster country_code) c
> ompact
 25.                         if !_rc {
 26.                             regsave using "`out_file'", tstat pval ci repl
> ace ///
>                                 addlabel(treat, `treat', inter, `inter', ///
>                                          fe, `fe_label', outcome, `outcome_lb
> l', ctrl, `ctrl')
 27.                         }
 28.                         else di as error "  [FALLITO] `tag'"
 29.                     }
 30.                     else di as text "  SKIP `tag' (gia' presente)"
 31.                 }
 32.             }
 33.         }
 34.         local fe_n = `fe_n' + 1
 35.     }
 36. end

. 
