. di as text _n "########## ASSEMBLAGGIO CSV ##########"

########## ASSEMBLAGGIO CSV ##########

. clear

. local first 1

. 
. foreach ov in ln_export ln_export_qua ln_export_value {
  2.     foreach treat in WB TREND {
  3.         foreach inter in NI Int {
  4.             foreach fe_label in fpd_year fpt_pd fpt_fpd fpd_pt {
  5.                 foreach ctrl in 0 1 {
  6.                     local tag "`treat'_`inter'_`fe_label'_`ov'_ctrl`ctrl'"
  7.                     local f "$TAB/OLS_19c_`tag'$OUTSFX.dta"
  8.                     cap confirm file "`f'"
  9.                     if !_rc {
 10.                         if `first' {
 11.                             use "`f'", clear
 12.                             local first 0
 13.                         }
 14.                         else {
 15.                             append using "`f'"
 16.                         }
 17.                     }
 18.                 }
 19.             }
 20.         }
 21.     }
 22. }
(variable var was str11, now str14 to accommodate using data's values)
(variable inter was str2, now str3 to accommodate using data's values)
(variable treat was str2, now str5 to accommodate using data's values)
(variable outcome was str9, now str13 to accommodate using data's values)
(variable outcome was str13, now str15 to accommodate using data's values)

. 
. if !`first' {
.     export delimited "$TAB/OLS_Ladder_reghdfe_19c$OUTSFX.csv", replace
