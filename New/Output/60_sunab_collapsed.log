  2.     gen byte g_m`k' = (rel_time == -`k') & !missing(rel_time)
  3.     local RELVARS "`RELVARS' g_m`k'"
  4. }

. forvalues k = 0/13 {
  2.     gen byte g_p`k' = (rel_time == `k') & !missing(rel_time)
  3.     local RELVARS "`RELVARS' g_p`k'"
  4. }

