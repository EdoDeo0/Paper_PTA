. local jcol = colnumb(`BI', "g_m6")

. if `jcol' == . {
.     di as error "colonna g_m6 non trovata in e(b_interact)"
.     exit 9
. }

. local nrowsB = rowsof(`BI')

. local rnames : rownames `BI'

. 
