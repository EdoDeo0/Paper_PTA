. *****************************************************************************
> ***
. * B. IW estimates + ATT aggregato
. *****************************************************************************
> ***
. * Programma: stima IW su un outcome, salva coefficienti per periodo e ATT.
. capture program drop sunab_run

. program define sunab_run
  1.     args outc relvars tag
  2.     eventstudyinteract `outc' `relvars' [aw=n_tot], ///
>         cohort(entry_year) control_cohort(nevertreated) ///
>         absorb(country_code year) vce(cluster country_code)
  3. 
.     tempname B V
  4.     mat `B' = e(b_iw)
  5.     mat `V' = e(V_iw)
  6.     local NN   = e(N)
  7.     local NCL  = e(N_clust)
  8. 
.     * pesi ATT: somma di n_tot sui periodi post nel campione di stima
.     tempvar insamp
  9.     gen byte `insamp' = e(sample)
 10. 
.     local L = colsof(`B')
 11.     mat WW = J(1, `L', 0)
 12.     forvalues j = 1/`L' {
 13.         local nm : word `j' of `relvars'
 14.         if substr("`nm'", 1, 3) == "g_p" {
 15.             local k = substr("`nm'", 4, .)
 16.             qui su n_tot if `insamp' & rel_time == `k' & !nevertreated, me
> anonly
 17.             mat WW[1, `j'] = cond(r(N) > 0, r(sum), 0)
 18.         }
 19.     }
 20. 
.     mata: b = st_matrix("`B'"); V = st_matrix("`V'"); w = st_matrix("WW")
 21.     mata: w = w :/ sum(w)
 22.     mata: st_numscalar("att_b", (w * b')[1,1])
 23.     mata: st_numscalar("att_v", (w * V * w')[1,1])
 24. 
.     scalar att_se = sqrt(att_v)
 25.     scalar att_t  = att_b / att_se
 26.     scalar att_p  = 2 * ttail(`NCL' - 1, abs(att_t))
 27.     di as res "[`tag'] ATT = " %9.6f att_b "  se = " %9.6f att_se "  p = "
>  %6.4f att_p
 28. 
.     * --- accumulo su file --------------------------------------------------
> --
.     preserve
 29.         clear
 30.         local NR = `L' + 1
 31.         set obs `NR'
 32.         gen str24 spec    = "`tag'"
 33.         gen str16 term    = ""
 34.         gen double coef   = .
 35.         gen double se     = .
 36.         gen double pval   = .
 37.         forvalues j = 1/`L' {
 38.             local nm : word `j' of `relvars'
 39.             qui replace term = "`nm'"                    in `j'
 40.             qui replace coef = `B'[1, `j']               in `j'
 41.             qui replace se   = sqrt(`V'[`j', `j'])       in `j'
 42.             qui replace pval = 2*ttail(`NCL'-1, abs(coef[`j']/se[`j'])) in
>  `j'
 43.         }
 44.         qui replace term = "ATT_aggregato" in `NR'
 45.         qui replace coef = att_b           in `NR'
 46.         qui replace se   = att_se          in `NR'
 47.         qui replace pval = att_p           in `NR'
 48.         gen long   nobs   = `NN'
 49.         gen int    nclust = `NCL'
 50.         gen str32  source = "eventstudyinteract_stata_60"
 51.         * NB: un `tempfile' creato dentro un program viene CANCELLATO all'
> uscita
.         * del program -> i pezzi si salvano come .dta veri (stile cache del p
> rogetto).
.         save "$TAB\SUNAB_`tag'.dta", replace
 52.     restore
 53. end

