. * --- programma per le varianti (registra solo il lead t=-6 e l'ATT) --------
> --
. capture program drop sunab_diag

. program define sunab_diag
  1.     args relvars tag
  2.     cap eventstudyinteract gap_dirty `relvars' [aw=n_tot], ///
>         cohort(entry_year) control_cohort(nevertreated) ///
>         absorb(country_code year) vce(cluster country_code)
  3.     if _rc {
  4.         di as error "[`tag'] stima fallita (rc=" _rc "), riga saltata"
  5.         exit 0
  6.     }
  7.     tempname B V
  8.     mat `B' = e(b_iw)
  9.     mat `V' = e(V_iw)
 10.     local NN  = e(N)
 11.     local NCL = e(N_clust)
 12.     local j   = colnumb(`B', "g_m6")
 13. 
.     tempvar insamp
 14.     gen byte `insamp' = e(sample)
 15.     local L = colsof(`B')
 16.     mat WW = J(1, `L', 0)
 17.     forvalues jj = 1/`L' {
 18.         local nm : word `jj' of `relvars'
 19.         if substr("`nm'", 1, 3) == "g_p" {
 20.             local k = substr("`nm'", 4, .)
 21.             qui su n_tot if `insamp' & rel_time == `k' & !nevertreated, me
> anonly
 22.             mat WW[1, `jj'] = cond(r(N) > 0, r(sum), 0)
 23.         }
 24.     }
 25.     mata: b = st_matrix("`B'"); V = st_matrix("`V'"); w = st_matrix("WW")
 26.     mata: w = w :/ sum(w)
 27.     mata: st_numscalar("att_b", (w * b')[1,1])
 28.     mata: st_numscalar("att_v", (w * V * w')[1,1])
 29.     scalar att_se = sqrt(att_v)
 30.     scalar att_p  = 2 * ttail(`NCL'-1, abs(att_b/att_se))
 31. 
.     preserve
 32.         clear
 33.         set obs 2
 34.         gen str24 spec  = "`tag'"
 35.         gen str16 term  = ""
 36.         gen str8  coorte = ""
 37.         gen double coef = .
 38.         gen double se   = .
 39.         gen double pval = .
 40.         if `j' != . {
 41.             qui replace term = "g_m6"                  in 1
 42.             qui replace coef = `B'[1, `j']             in 1
 43.             qui replace se   = sqrt(`V'[`j', `j'])     in 1
 44.             qui replace pval = 2*ttail(`NCL'-1, abs(coef[1]/se[1])) in 1
 45.         }
 46.         qui replace term = "ATT" in 2
 47.         qui replace coef = att_b in 2
 48.         qui replace se   = att_se in 2
 49.         qui replace pval = att_p in 2
 50.         qui drop if missing(coef)
 51.         gen long  nobs   = `NN'
 52.         gen int   nclust = `NCL'
 53.         save "$TAB\SUNABDIAG_`tag'.dta", replace
 54.     restore
 55.     global DIAGTAGS "$DIAGTAGS `tag'"
 56. end

