. *── Gestione draws (resume-safe) ────────────────────────────────────────────
> ─
. local start_rep = 1

. local skip_loop = 0

. cap confirm file "$DRAWS"

. if !_rc {
.     cap import delimited "$DRAWS", clear varnames(1) case(preserve)
.     if !_rc {
.         qui count
.         local ndone = r(N)
.     }
.     else local ndone = 0
.     if `ndone' > 0 {
.         di as text "Draws presenti: `ndone' -- riprendo da rep " `ndone'+1
Draws presenti: 1000 -- riprendo da rep 1001
.         local start_rep = `ndone' + 1
.         if `start_rep' > $NREPS local skip_loop = 1
.     }
.     else {
.         file open fh using "$DRAWS", write replace text
.         file write fh "rep,b_wb_green,b_wb_dirty,b_tr_green,b_tr_dirty" _n
.         file close fh
.     }
. }

. else {
.     file open fh using "$DRAWS", write replace text
.     file write fh "rep,b_wb_green,b_wb_dirty,b_tr_green,b_tr_dirty" _n
.     file close fh
. }

. 
. *── Loop di permutazione ────────────────────────────────────────────────────
> ─
. if !`skip_loop' {
. forvalues b = `start_rep'/$NREPS {
  2.     if mod(`b', 50) == 0 di as text "Rep `b'/$NREPS -- " c(current_time)
  3. 
.     * seed dipendente solo da `b': una ripresa riproduce gli stessi numeri
.     set seed `= 1000000 + `b' * 7919'
  4. 
.     use `clist', clear
  5.     gen double u = runiform()
  6.     sort u
  7.     rename country_code donor_cc
  8.     gen int recv_rank = _n
  9.     tempfile donors
 10.     save `donors'
 11. 
.     use `clist', clear
 12.     gen int recv_rank = _n
 13.     merge 1:1 recv_rank using `donors', keepusing(donor_cc) nogen
 14.     keep country_code donor_cc
 15.     tempfile bijection
 16.     save `bijection'
 17. 
.     use `tprofile', clear
 18.     rename country_code donor_cc
 19.     merge m:1 donor_cc using `bijection', keepusing(country_code) nogen
 20.     keep country_code year WB_EP_Depth TREND_EP_Count $DEPTHVAR
 21.     sort country_code year
 22.     tempfile perm_treat
 23.     save `perm_treat'
 24. 
.     * keep(master match): i profili non sono bilanciati, le coppie (paese,ann
> o)
.     * inesistenti nel panel vanno scartate, non aggiunte (identico a R).
.     use `base', clear
 25.     merge m:1 country_code year using `perm_treat', keep(master match) nog
> en
 26.     foreach v in WB_EP_Depth TREND_EP_Count $DEPTHVAR {
 27.         replace `v' = 0 if missing(`v')
 28.     }
 29. 
.     gen double ep_green = WB_EP_Depth * env_good
 30.     gen double ep_dirty = WB_EP_Depth * dirty_p
 31.     gen double td_green = $DEPTHVAR * env_good
 32.     gen double td_dirty = $DEPTHVAR * dirty_p
 33.     qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], absorb(pd dt
>  pt) compact
 34.     local b_wb_g = _b[ep_green]
 35.     local b_wb_d = _b[ep_dirty]
 36.     drop ep_green ep_dirty td_green td_dirty
 37. 
.     gen double ep_green = TREND_EP_Count * env_good
 38.     gen double ep_dirty = TREND_EP_Count * dirty_p
 39.     gen double td_green = $DEPTHVAR * env_good
 40.     gen double td_dirty = $DEPTHVAR * dirty_p
 41.     qui reghdfe y ep_green ep_dirty td_green td_dirty [aw=n], absorb(pd dt
>  pt) compact
 42.     local b_tr_g = _b[ep_green]
 43.     local b_tr_d = _b[ep_dirty]
 44. 
.     file open fh using "$DRAWS", write append text
 45.     file write fh "`b',`b_wb_g',`b_wb_d',`b_tr_g',`b_tr_d'" _n
 46.     file close fh
 47. }
. }

