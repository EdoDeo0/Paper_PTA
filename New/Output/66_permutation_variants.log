. foreach s in wb_g wb_d tr_g tr_d {
  2.     local col = cond("`s'" == "wb_g", "b_wb_green", ///
>                 cond("`s'" == "wb_d", "b_wb_dirty",  ///
>                 cond("`s'" == "tr_g", "b_tr_green", "b_tr_dirty")))
  3.     local bo = cond("`s'" == "wb_g", `b_obs_wb_g', ///
>                 cond("`s'" == "wb_d", `b_obs_wb_d', ///
>                 cond("`s'" == "tr_g", `b_obs_tr_g', `b_obs_tr_d')))
  4.     qui count if abs(`col') >= abs(`bo')
  5.     local n_ext_`s' = r(N)
  6.     local p_`s'     = (1 + r(N)) / (1 + `nreps')
  7.     local pn_`s'    = r(N) / `nreps'
  8.     di as text "  `s': b_obs=" `bo' "  n_extreme=" r(N) "  p=" `p_`s''
  9. }
