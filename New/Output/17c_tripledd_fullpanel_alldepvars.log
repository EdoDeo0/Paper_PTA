. *════════════════════════════════════════════════════════════════════════════
> ══
. * Programma generico: stima triple-diff per una outcome
. *════════════════════════════════════════════════════════════════════════════
> ══
. capture program drop run_tripledd_outcome

. program define run_tripledd_outcome
  1.     args outcome_var raw_var outfile_tag
  2. 
.     * Cache check
.     local cache_wb "$ROOT/New/Output/TripleDiff/Tables/_full17c_WB_`outfile_t
> ag'$OUTSFX.dta"
  3.     local cache_tr "$ROOT/New/Output/TripleDiff/Tables/_full17c_TREND_`out
> file_tag'$OUTSFX.dta"
  4.     cap confirm file "`cache_wb'"
  5.     local wb_cached = (_rc == 0)
  6.     cap confirm file "`cache_tr'"
  7.     local tr_cached = (_rc == 0)
  8. 
.     if `wb_cached' & `tr_cached' {
  9.         di "[SKIP] `outcome_var': entrambi i trattamenti gia' cached"
 10.         exit
 11.     }
 12. 
.     * Carica dati
.     if "`raw_var'" == "ln_export" {
 13.         use ln_export WB_EP_Depth TREND_EP_Count hs6 country_code year fpd
>  fdt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 14.     }
 15.     else if "`raw_var'" == "exp_qua" {
 16.         use exp_qua WB_EP_Depth TREND_EP_Count hs6 country_code year fpd f
> dt pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 17.         gen double ln_export_qua = ln(exp_qua)
 18.         drop exp_qua
 19.     }
 20.     else if "`raw_var'" == "uv_exp" {
 21.         use uv_exp WB_EP_Depth TREND_EP_Count hs6 country_code year fpd fd
> t pt ///
>             using "$ROOT/Data/Final Dataset/final_dataset_pta_env_indices_com
> pressed.dta", clear
 22.         gen double ln_export_value = ln(uv_exp)
 23.         drop uv_exp
 24.     }
 25. 
.     gen byte hkmo = inlist(country_code, 110, 121)
 26.     keep if $HKMOEXPR
 27.     drop hkmo
 28. 
.     merge m:1 hs6 using "$F_GREEN", keep(master match) nogen
 29.     replace env_good_new = 0 if missing(env_good_new)
 30.     merge m:1 hs6 using "$F_DIRTY", keep(master match) nogen
 31.     replace dirty_p = 0 if missing(dirty_p)
 32.     merge m:1 country_code year using "$F_DEPTH", keep(master match) nogen
 33.     if $DROP_UNMEASURED {
 34.         drop if missing($DEPTHVAR) & WB_EP_Depth > 0
 35.     }
 36.     replace $DEPTHVAR = 0 if missing($DEPTHVAR)
 37. 
.     gen double wb_green = WB_EP_Depth    * env_good_new
 38.     gen double wb_dirty = WB_EP_Depth    * dirty_p
 39.     gen double tr_green = TREND_EP_Count * env_good_new
 40.     gen double tr_dirty = TREND_EP_Count * dirty_p
 41.     gen double td_green = $DEPTHVAR * env_good_new
 42.     gen double td_dirty = $DEPTHVAR * dirty_p
 43.     drop WB_EP_Depth TREND_EP_Count env_good_new dirty_p $DEPTHVAR hs6
 44. 
.     count
 45.     di "[`outcome_var'] Righe: " r(N)
 46. 
.     * WB
.     if !`wb_cached' {
 47.         reghdfe `outcome_var' wb_green wb_dirty td_green td_dirty, ///
>             absorb(fpd fdt pt) vce(cluster country_code) compact
 48.         local ncl = e(N_clust)
 49.         regsave using "`cache_wb'", ///
>             tstat pval ci replace addlabel(treat, WB, fe, "fpd+fdt+pt", ///
>             nclust, `ncl', outcome, `outcome_var')
 50.         di "[OK] WB `outcome_var' — N=" e(N) " clusters=" `ncl'
 51.     }
 52. 
.     * TREND
.     if !`tr_cached' {
 53.         cap noisily reghdfe `outcome_var' tr_green tr_dirty td_green td_di
> rty, ///
>             absorb(fpd fdt pt) vce(cluster country_code) compact
 54.         if !_rc {
 55.             local ncl = e(N_clust)
 56.             regsave using "`cache_tr'", ///
>                 tstat pval ci replace addlabel(treat, TREND, fe, "fpd+fdt+pt"
> , ///
>                 nclust, `ncl', outcome, `outcome_var')
 57.             di "[OK] TREND `outcome_var' — N=" e(N) " clusters=" `ncl'
 58.         }
 59.     }
 60. end

. 
