file C:\Users\edodr\AppData\Local\Temp\ST_24bc_000001.tmp saved as .dta
    format

. 
. capture program drop est_one

. program define est_one
  1.     args variant depth clus
  2.     * depth: td | desta
.     if "`depth'" == "desta" {
  3.         drop if missing(DESTA_depth_index) & WB_EP_Depth > 0
  4.         gen double TD = cond(missing(DESTA_depth_index), 0, DESTA_depth_in
> dex)
  5.     }
  6.     else gen double TD = TotalDepth_nonEnv
  7.     foreach ix in WB TREND {
  8.         local ep = cond("`ix'"=="WB", "WB_EP_Depth", "TREND_EP_Count")
  9.         gen double ep_g = `ep' * env_good
 10.         gen double ep_d = `ep' * dirty_p
 11.         gen double td_g = TD * env_good
 12.         gen double td_d = TD * dirty_p
 13.         reghdfe y ep_g ep_d td_g td_d [aw=n], absorb(pd dt pt) vce(cluster
>  `clus')
 14.         local nc = e(N_clust)
 15.         local pg = 2*ttail(`nc'-1, abs(_b[ep_g]/_se[ep_g]))
 16.         local pd = 2*ttail(`nc'-1, abs(_b[ep_d]/_se[ep_d]))
 17.         file open fh using "$CSV", write append text
 18.         file write fh "`variant',`depth',`ix',`clus'," (_b[ep_g]) "," (_se
> [ep_g]) "," (`pg') "," (_b[ep_d]) "," (_se[ep_d]) "," (`pd') "," (e(N)) "," (
> `nc') _n
 19.         file close fh
 20.         drop ep_g ep_d td_g td_d
 21.     }
 22.     drop TD
 23. end

. 
. * recode helper: set (cc, y0) treatment vars to their (cc, y0-1) values
. capture program drop recode_prev

. program define recode_prev
  1.     args cc y0
  2.     foreach v in WB_EP_Depth TREND_EP_Count TotalDepth_nonEnv DESTA_depth_
> index {
  3.         qui su `v' if country_code == `cc' & year == `y0'-1, meanonly
  4.         local m = cond(r(N) > 0, r(mean), 0)
  5.         qui replace `v' = `m' if country_code == `cc' & year == `y0'
  6.     }
  7. end

